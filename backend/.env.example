NODE_ENV=development
# Defaults preserve existing live deployments. For isolated Render staging use
# NODE_ENV=production, APP_ENV=staging, INTEGRATION_MODE=mock (or disabled), and
# remove all real provider variables below. Staging rejects provider credentials.
APP_ENV=development
INTEGRATION_MODE=live
# PUBLIC_BASE_URL=https://onelife-staging.onrender.com
# Staging ONLY: independently generated access credentials, separate from JWT.
# STAGING_BASIC_AUTH_USER=onelife-reviewer
# STAGING_BASIC_AUTH_PASSWORD=replace-with-an-independent-random-secret
# STAGING_MONGO_HOST=your-isolated-cluster.mongodb.net
# STAGING_MONGO_DATABASE=onelife_staging
PORT=8000
DATABASE_URL=mongodb://127.0.0.1:27017/onelife
# Required in production: use a unique, randomly generated value of at least 32 characters.
# The legacy lowercase `secret` variable is accepted temporarily for existing deployments, but new deployments must use JWT_SECRET.
JWT_SECRET=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_with_the_webhook_secret_from_razorpay
VIDEO_MEETING_BASE_URL=https://meet.jit.si
GEMINI_API_KEY=replace_me
mail_user=replace_me
mail_pass=replace_me
MAIL_FROM=support@your-hospital.example
mail_port=465
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
