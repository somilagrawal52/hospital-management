<%- include('partials/head', { pageTitle: 'Doctors Details - OneLife' }) %>
<%- include('partials/header', { adminName: 'Admin Panel', adminSubtitle: 'Hospital Management' }) %>
<%- include('partials/sidebar', { activePage: 'details' }) %>

    <main id="main" class="main">
      <div class="pagetitle">
        <h1>Doctors Details</h1>
        <p class="text-muted mb-0">Manage registered clinicians and their directory details.</p>
      </div>

      <section class="section">
        <div class="row">
          <% doctors.forEach((doctor) => { %>
            <div class="col-md-6 col-xl-4">
              <div class="card h-100 shadow-sm">
                <div class="card-body pt-3">
                  <div class="text-center mb-3">
                    <img src="<%= doctor.image %>" alt="Dr. <%= doctor.fullname %>" class="rounded-circle object-fit-cover" style="width: 120px; height: 120px;" />
                  </div>
                  <p><strong>Name:</strong> <%= doctor.fullname %></p>
                  <p><strong>Department:</strong> <%= doctor.speciality || "N/A" %></p>
                  <p><strong>Email:</strong> <%= doctor.email %></p>
                  <p><strong>Gender:</strong> <%= doctor.gender || "N/A" %></p>
                  <p><strong>Phone:</strong> <%= doctor.number || "N/A" %></p>
                  <form method="post" action="/clear/<%= doctor._id %>" onsubmit="return confirm('Remove this doctor account?');">
                    <button class="btn btn-outline-danger btn-sm" type="submit">Remove doctor</button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
          <% if (!doctors.length) { %>
            <div class="col-12">
              <div class="card">
                <div class="card-body py-4">
                  <p class="mb-0">No doctors found.</p>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </section>
    </main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
