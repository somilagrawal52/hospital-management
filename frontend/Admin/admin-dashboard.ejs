<%- include('partials/head', { pageTitle: 'Administration dashboard | OneLife' }) %>
<%- include('partials/header', { adminName: 'Admin' }) %>
<%- include('partials/sidebar', { activePage: 'dashboard' }) %>

<main id="main-content" class="console-main">
  <header class="console-page-heading">
    <div><p class="console-eyebrow">Care operations</p><h1>Hospital overview</h1><p>Track care activity and keep appointments moving.</p></div>
  </header>

  <section class="console-grid console-grid--metrics" aria-label="Key statistics">
    <article class="console-metric"><div class="console-metric__label"><span class="nav-glyph" aria-hidden="true">P</span>Registered patients</div><p class="console-metric__value"><%= patientsCount %></p><p class="console-metric__note">Patient accounts on the platform</p></article>
    <article class="console-metric"><div class="console-metric__label"><span class="nav-glyph" aria-hidden="true">D</span>Active clinicians</div><p class="console-metric__value"><%= doctorsCount %></p><p class="console-metric__note">Doctors in the directory</p></article>
    <article class="console-metric"><div class="console-metric__label"><span class="nav-glyph" aria-hidden="true">T</span>Today’s schedule</div><p class="console-metric__value"><%= todayAppointmentsCount %></p><p class="console-metric__note">Appointments not cancelled</p></article>
  </section>

  <section class="console-panel" style="margin-top: 1.2rem">
    <div class="console-panel__header"><div><h2>Recent appointments</h2><p>Review and update the latest patient bookings.</p></div></div>
    <div class="console-panel__body">
      <div class="console-table-wrap">
        <table class="console-table">
          <thead><tr><th>Patient</th><th>Doctor</th><th>Phone</th><th>Date</th><th>Status</th><th>Update</th></tr></thead>
          <tbody>
            <% appointments.forEach((appointment) => { %>
              <% const status = appointment.status || 'pending'; const statusTone = status === 'cancelled' ? 'danger' : status === 'completed' ? 'success' : status === 'pending' || status === 'online_requested' ? 'warning' : ''; %>
              <tr>
                <td><%= appointment.fullname || '—' %></td><td><%= appointment.doctor || '—' %></td><td><%= appointment.number || '—' %></td><td><%= appointment.formattedDate %></td>
                <td><span class="console-pill <%= statusTone ? `console-pill--${statusTone}` : '' %>"><%= status.replace(/_/g, ' ') %></span></td>
                <td>
                  <% if (!['completed', 'cancelled'].includes(status)) { %>
                    <div class="console-inline">
                      <label><span class="console-skip-link">New appointment status</span><select class="console-field status-select" aria-label="Update appointment status"><option value="">Update status</option><% if (status !== 'confirmed') { %><option value="confirmed">Confirm</option><% } %><option value="completed">Complete</option><option value="cancelled">Cancel</option></select></label>
                      <button type="button" class="console-button console-button--small update-status" data-id="<%= appointment._id %>">Save</button>
                    </div>
                  <% } else { %><span class="console-status">Final</span><% } %>
                </td>
              </tr>
            <% }) %>
            <% if (!appointments.length) { %><tr><td colspan="6" class="console-empty">No appointments found.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<script>
  document.addEventListener('click', async (event) => {
    const button = event.target.closest('.update-status');
    if (!button) return;
    const status = button.closest('td').querySelector('.status-select').value;
    if (!status) return window.alert('Choose a new status first.');
    button.disabled = true;
    try {
      const response = await fetch('/appointments/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ appointmentId: button.dataset.id, status }) });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || 'Unable to update appointment.');
      window.location.reload();
    } catch (error) { button.disabled = false; window.alert(error.message || 'Unable to update appointment.'); }
  });
</script>
<%- include('partials/scripts') %>
