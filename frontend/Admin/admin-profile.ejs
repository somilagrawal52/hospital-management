<%- include('partials/head', { pageTitle: 'Profile | OneLife Administration' }) %>
<%- include('partials/header', { adminName: admin?.fullname || 'Admin' }) %>
<%- include('partials/sidebar', { activePage: 'profile' }) %>

<main id="main-content" class="console-main">
  <header class="console-page-heading"><div><p class="console-eyebrow">Account</p><h1>Your administration profile</h1><p>Profile information associated with this OneLife administrator account.</p></div></header>
  <section class="console-grid console-grid--wide"><article class="console-profile-card console-person-card"><div class="console-avatar"><%= (admin?.fullname || 'A').charAt(0).toUpperCase() %></div><div><h2><%= admin?.fullname || 'Admin' %></h2><p>Administrator</p></div><p class="console-status">This account manages hospital operations and support.</p></article><article class="console-panel"><div class="console-panel__header"><div><h2>Profile details</h2><p>Read-only account information.</p></div></div><div class="console-panel__body"><dl class="console-key-value"><div><dt>Full name</dt><dd><%= admin?.fullname || 'N/A' %></dd></div><div><dt>Role</dt><dd><%= admin?.role || 'ADMIN' %></dd></div><div><dt>Country</dt><dd><%= admin?.country || 'N/A' %></dd></div><div><dt>Phone</dt><dd><%= admin?.number || 'N/A' %></dd></div><div><dt>Email</dt><dd><%= admin?.email || 'N/A' %></dd></div></dl></div></article></section>
</main>
<%- include('partials/footer') %>
<%- include('partials/scripts') %>
