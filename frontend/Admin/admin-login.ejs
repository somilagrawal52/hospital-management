<%- include('partials/head', { pageTitle: 'Admin Login - OneLife' }) %>
    <main>
      <div class="container">
        <section class="py-4 section register min-vh-100 d-flex flex-column align-items-center justify-content-center">
          <div class="container">
            <div class="row justify-content-center">
              <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">
                <div class="py-4 d-flex justify-content-center">
                  <a href="/admin/login" class="w-auto logo d-flex align-items-center">
                    <img src="/admin-assets/img/logo.png" alt="OneLife" />
                    <span class="d-none d-lg-block">Admin</span>
                  </a>
                </div>

                <div class="mb-3 card">
                  <div class="card-body">
                    <div class="pt-4 pb-2">
                      <h5 class="pb-0 text-center card-title fs-4">Login to Your Account</h5>
                      <p class="text-center small">Enter your email and password to login</p>
                    </div>

                    <% if (error) { %>
                      <div class="alert alert-danger py-2" role="alert"><%= error %></div>
                    <% } %>

                    <form class="row g-3 needs-validation" action="/admin/login" method="post" novalidate>
                      <div class="col-12">
                        <label class="form-label">Email</label>
                        <div class="input-group has-validation">
                          <span class="input-group-text">@</span>
                          <input
                            type="email"
                            name="email"
                            class="form-control"
                            value="<%= email %>"
                            required
                          />
                          <div class="invalid-feedback">Please enter your email.</div>
                        </div>
                      </div>

                      <div class="col-12">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" required />
                        <div class="invalid-feedback">Please enter your password.</div>
                      </div>

                      <div class="col-12">
                        <button class="btn btn-primary w-100" type="submit">Login</button>
                      </div>
                    </form>
                  </div>
                </div>

                <div class="credits">Designed by Somil Agrawal</div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>
<%- include('partials/scripts') %>
