<!doctype html>
<html lang="en">
  <head>
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
    <script src="/console-assets/js/csrf.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f5f70" />
    <title>Admin Login - OneLife</title>
    <link rel="stylesheet" href="/admin-assets/css/onelife-admin-login.css" />
  </head>
  <body class="admin-login-page">
    <main class="admin-login-shell">
      <section class="admin-login-intro" aria-labelledby="admin-login-heading">
        <a class="brand" href="/admin/login" aria-label="OneLife Hospital administration login">
          <span class="brand-mark" aria-hidden="true"><span></span></span>
          <span class="brand-copy">
            <strong>OneLife</strong>
            <span>Hospital administration</span>
          </span>
        </a>

        <div class="intro-copy">
          <p class="eyebrow">Administration portal</p>
          <h1 id="admin-login-heading">A clearer start to every care day.</h1>
          <p>
            Sign in to coordinate appointments, support teams, and hospital operations from one secure place.
          </p>
        </div>

        <p class="intro-note">OneLife Hospital · Internal access only</p>
      </section>

      <section class="admin-login-panel" aria-label="Administrator sign in">
        <div class="login-card">
          <div class="login-card__heading">
            <p class="eyebrow">Welcome back</p>
            <h2>Sign in to administration</h2>
            <p>Use your administrator email and password to continue.</p>
          </div>

          <% if (error) { %>
            <div class="server-error" role="alert"><%= error %></div>
          <% } %>

          <form id="admin-login-form" action="/admin/login" method="post" novalidate><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
            <div class="form-field">
              <label for="email">Email address</label>
              <input
                id="email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                value="<%= email || '' %>"
                aria-describedby="email-help"
                required
              />
              <p id="email-help" class="field-help">Enter the email linked to your administrator account.</p>
              <p class="field-error">Please enter a valid email address.</p>
            </div>

            <div class="form-field">
              <label for="password">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
              />
              <p class="field-error">Please enter your password.</p>
            </div>

            <button class="submit-button" type="submit">Sign in securely</button>
          </form>

          <p class="support-copy">Need access? Please contact the OneLife system administrator.</p>
        </div>
      </section>
    </main>

    <script>
      (function () {
        var form = document.getElementById('admin-login-form');

        form.addEventListener('submit', function (event) {
          if (!form.checkValidity()) {
            event.preventDefault();
            form.classList.add('was-validated');
            form.querySelector(':invalid').focus();
          }
        });
      })();
    </script>
  </body>
</html>
