<header class="console-header">
  <button class="console-nav-toggle" type="button" data-sidebar-toggle aria-label="Open navigation" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <a class="console-brand" href="/admin" aria-label="OneLife administration home">
    <span class="console-brand__mark" aria-hidden="true"></span>
    <span class="console-brand__copy"><strong>OneLife</strong><span>Administration</span></span>
  </a>
  <div class="console-inline">
    <a class="console-button console-button--quiet console-button--small" href="/showmsg">Support inbox</a>
    <details class="console-menu">
      <summary aria-label="Open account menu"><span class="console-avatar"><%= (adminName || 'A').charAt(0).toUpperCase() %></span><span><%= adminName || 'Admin' %></span></summary>
      <div class="console-menu__panel">
        <a href="/profile">Profile</a>
        <a href="/admin/logout">Sign out</a>
      </div>
    </details>
  </div>
</header>
