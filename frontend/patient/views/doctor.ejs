<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'Medical Specialists & Clinicians - OneLife' }) %>

<div class="py-8">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-slate-200 pb-7 mb-10">
    <div>
      <span class="inline-block rounded-full bg-indigo-50 border border-indigo-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-primary">Clinician Directory</span>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2.5 tracking-tight">Meet Our Medical Specialists</h1>
      <p class="text-sm text-slate-600 mt-1.5">Browse verified clinicians, compare consultation fees, and schedule in-clinic or virtual telehealth visits.</p>
    </div>
    <!-- Live Doctor Filter / Search -->
    <div class="w-full md:w-80">
      <div class="relative">
        <input
          type="search"
          id="doctor-search"
          placeholder="Search by doctor, degree, speciality…"
          class="w-full rounded-2xl border border-slate-300 bg-white py-3 pl-10 pr-4 text-xs font-semibold text-slate-900 placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-xs transition"
        />
        <span class="absolute left-3.5 top-3 text-slate-400 text-sm" aria-hidden="true">🔍</span>
      </div>
    </div>
  </div>

  <div class="flex flex-col lg:flex-row items-start gap-8">
    <!-- Department Sidebar Filters -->
    <aside class="w-full lg:w-72 shrink-0 space-y-4">
      <div class="rounded-3xl border border-slate-200/90 bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between mb-4 px-1">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">Departments</h2>
          <span class="text-[11px] font-semibold text-slate-500">Filter By Field</span>
        </div>
        <div class="flex flex-wrap lg:flex-col gap-1.5 text-xs font-semibold">
          <a
            href="/doctors"
            class="flex items-center justify-between rounded-2xl px-4 py-3 transition-all <%= !speciality ? 'bg-primary text-white shadow-md shadow-primary/25' : 'text-slate-700 hover:bg-slate-100 hover:text-primary' %>"
          >
            <div class="flex items-center gap-2">
              <span>🏥</span>
              <span>All Departments</span>
            </div>
            <span class="text-[11px] <%= !speciality ? 'text-indigo-200 font-bold' : 'text-slate-400' %>">&rarr;</span>
          </a>
          <% const specialities = ['General physician', 'Gynecologist', 'Dermatologist', 'Pediatricians', 'Neurologist', 'Gastroenterologist']; %>
          <% specialities.forEach((name) => { %>
            <a
              href="<%= speciality === name ? '/doctors' : `/doctors/${encodeURIComponent(name)}` %>"
              class="flex items-center justify-between rounded-2xl px-4 py-3 transition-all <%= speciality === name ? 'bg-primary text-white shadow-md shadow-primary/25' : 'text-slate-700 hover:bg-slate-100 hover:text-primary' %>"
            >
              <span><%= name %></span>
              <% if (speciality === name) { %>
                <span class="text-xs font-bold">&check;</span>
              <% } else { %>
                <span class="text-[11px] text-slate-400">&rarr;</span>
              <% } %>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Virtual Care Info Card -->
      <div class="rounded-3xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/80 to-teal-50/60 p-5 text-xs text-emerald-950 shadow-xs">
        <div class="flex items-center gap-2.5 font-bold text-emerald-900 mb-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 text-sm">📹</div>
          <span>Telehealth Consultations</span>
        </div>
        <p class="leading-relaxed text-emerald-900 font-normal">Online appointments feature encrypted HD video powered by Jitsi WebRTC, iCal calendar invites, and instant digital prescription receipts.</p>
      </div>
    </aside>

    <!-- Doctors Cards Grid -->
    <main class="flex-1 w-full">
      <div id="doctors-container" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
        <% filterDoc.forEach((item) => { %>
          <article
            class="doctor-card flex flex-col overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-xs transition-all duration-300 hover:shadow-xl hover:border-primary/50 hover:-translate-y-1.5 group"
            data-name="<%= (item.fullname || '').toLowerCase() %>"
            data-speciality="<%= (item.speciality || '').toLowerCase() %>"
            data-degree="<%= (item.degree || '').toLowerCase() %>"
          >
            <!-- Photo & Status Header -->
            <div class="relative bg-gradient-to-b from-indigo-50/60 to-slate-100 p-5 text-center">
              <span class="absolute top-3.5 right-3.5 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold <%= item.available ? 'bg-emerald-100/90 text-emerald-800 ring-1 ring-emerald-500/20' : 'bg-slate-200 text-slate-700' %>">
                <span class="h-1.5 w-1.5 rounded-full <%= item.available ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400' %>"></span>
                <%= item.available ? 'Available' : 'Paused' %>
              </span>
              <img
                class="mx-auto h-32 w-32 rounded-full object-cover border-4 border-white shadow-md bg-white transition duration-300 group-hover:scale-105"
                src="<%= item.image || '/assets/onelife-clinician-generated.png' %>"
                alt="Dr. <%= item.fullname %>"
              />
            </div>

            <!-- Body Information -->
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-primary transition-colors">Dr. <%= item.fullname %></h3>
                  <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] text-white font-bold" title="Verified Clinician">✓</span>
                </div>
                <div class="flex items-center text-xs font-bold gap-0.5">
                  <% if (item.ratingCount > 0) { %>
                    <span class="text-amber-400">★</span>
                    <span class="text-slate-800 text-[11px]"><%= Number(item.ratingAverage).toFixed(1) %> (<%= item.ratingCount %>)</span>
                  <% } else { %>
                    <span class="rounded-md bg-emerald-50 px-1.5 py-0.5 text-[10px] text-emerald-700">Verified</span>
                  <% } %>
                </div>
              </div>
              <p class="text-xs font-bold text-primary mt-1"><%= item.speciality %></p>
              <p class="text-xs text-slate-500 mt-1"><%= item.degree || 'MBBS' %> · <%= item.experience ? `${item.experience} Years Exp.` : 'Experienced Specialist' %></p>
              
              <% if (item.about) { %>
                <p class="text-xs text-slate-600 mt-2.5 line-clamp-2 leading-relaxed"><%= item.about %></p>
              <% } %>

              <!-- Consultation Badges -->
              <div class="mt-3 flex items-center gap-2 text-[10px] font-semibold text-slate-500">
                <span class="rounded-md bg-slate-100 px-2 py-0.5">🏥 In-Clinic</span>
                <span class="rounded-md bg-indigo-50 text-primary px-2 py-0.5">📹 Telehealth</span>
              </div>

              <div class="mt-4 pt-3.5 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-500">Consultation Fee</span>
                <div class="text-right">
                  <span class="text-base font-extrabold text-slate-900">₹<%= item.fees || 500 %></span>
                  <span class="block text-[10px] text-emerald-600 font-semibold">Instant Confirmation</span>
                </div>
              </div>

              <a
                href="/appointment/<%= item._id %>"
                class="mt-4 flex items-center justify-center gap-1.5 w-full rounded-2xl bg-slate-900 py-3 text-center text-xs font-bold text-white transition-all duration-300 group-hover:bg-primary shadow-xs"
              >
                <span>Book Appointment</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        <% }); %>

        <% if (!filterDoc.length) { %>
          <div class="col-span-full rounded-3xl border border-dashed border-slate-300 p-12 text-center bg-white">
            <p class="text-lg font-bold text-slate-800">No doctors match this specialty yet.</p>
            <p class="text-xs text-slate-500 mt-1.5">Try selecting another department or explore all clinicians.</p>
            <a href="/doctors" class="mt-4 inline-block rounded-2xl bg-primary px-6 py-2.5 text-xs font-bold text-white shadow-md shadow-primary/25">View All Clinicians</a>
          </div>
        <% } %>
      </div>

      <!-- No search match banner -->
      <div id="no-search-results" class="hidden rounded-3xl border border-dashed border-slate-300 p-12 text-center mt-6 bg-white">
        <p class="text-base font-bold text-slate-800">No clinicians matched your search.</p>
        <p class="text-xs text-slate-500 mt-1">Try searching for a different doctor's name or clear the search input.</p>
      </div>
    </main>
  </div>
</div>

<script>
  // Real-time live client-side search filter
  const searchInput = document.getElementById('doctor-search');
  const cards = document.querySelectorAll('.doctor-card');
  const noResults = document.getElementById('no-search-results');

  searchInput?.addEventListener('input', (e) => {
    const term = e.target.value.toLowerCase().trim();
    let matches = 0;

    cards.forEach((card) => {
      const name = card.dataset.name || '';
      const speciality = card.dataset.speciality || '';
      const degree = card.dataset.degree || '';
      const isMatch = name.includes(term) || speciality.includes(term) || degree.includes(term);

      card.style.display = isMatch ? 'flex' : 'none';
      if (isMatch) matches++;
    });

    if (noResults) {
      noResults.classList.toggle('hidden', matches > 0 || cards.length === 0);
    }
  });
</script>

<%- include('partials/page-end') %>
