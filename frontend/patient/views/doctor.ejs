<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'Medical Specialists & Clinicians - OneLife' }) %>

<div class="py-8">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200 pb-6 mb-8">
    <div>
      <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary">Clinician Directory</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Meet Our Medical Specialists</h1>
      <p class="text-sm text-slate-600 mt-1">Browse verified clinicians, compare consultation fees, and schedule in-clinic or virtual telehealth visits.</p>
    </div>
    <!-- Live Doctor Filter / Search -->
    <div class="w-full md:w-72">
      <div class="relative">
        <input
          type="search"
          id="doctor-search"
          placeholder="Search by name or degree…"
          class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 pl-9 pr-4 text-xs font-medium text-slate-900 placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
        />
        <span class="absolute left-3 top-3 text-slate-400 text-xs" aria-hidden="true">🔍</span>
      </div>
    </div>
  </div>

  <div class="flex flex-col lg:flex-row items-start gap-8">
    <!-- Department Sidebar Filters -->
    <aside class="w-full lg:w-64 shrink-0 space-y-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3 px-2">Departments</h2>
        <div class="flex flex-wrap lg:flex-col gap-1.5 text-xs font-semibold">
          <a
            href="/doctors"
            class="flex items-center justify-between rounded-xl px-3.5 py-2.5 transition <%= !speciality ? 'bg-primary text-white shadow-md' : 'text-slate-700 hover:bg-slate-100' %>"
          >
            <span>All Departments</span>
            <span class="text-[11px] <%= !speciality ? 'text-indigo-200' : 'text-slate-400' %>">&rarr;</span>
          </a>
          <% const specialities = ['General physician', 'Gynecologist', 'Dermatologist', 'Pediatricians', 'Neurologist', 'Gastroenterologist']; %>
          <% specialities.forEach((name) => { %>
            <a
              href="<%= speciality === name ? '/doctors' : `/doctors/${encodeURIComponent(name)}` %>"
              class="flex items-center justify-between rounded-xl px-3.5 py-2.5 transition <%= speciality === name ? 'bg-primary text-white shadow-md' : 'text-slate-700 hover:bg-slate-100' %>"
            >
              <span><%= name %></span>
              <% if (speciality === name) { %>
                <span class="text-xs">&check;</span>
              <% } %>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Virtual Care Info Card -->
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 text-xs text-emerald-950">
        <div class="flex items-center gap-2 font-bold text-emerald-800 mb-1">
          <span>📹</span> Telehealth Consultations
        </div>
        <p class="leading-relaxed text-emerald-900">Online appointments feature encrypted HD video powered by Jitsi, calendar invites, and digital prescription receipts.</p>
      </div>
    </aside>

    <!-- Doctors Cards Grid -->
    <main class="flex-1 w-full">
      <div id="doctors-container" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
        <% filterDoc.forEach((item) => { %>
          <article
            class="doctor-card flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:shadow-xl hover:border-primary/50 hover:-translate-y-1"
            data-name="<%= (item.fullname || '').toLowerCase() %>"
            data-speciality="<%= (item.speciality || '').toLowerCase() %>"
            data-degree="<%= (item.degree || '').toLowerCase() %>"
          >
            <!-- Photo & Status Header -->
            <div class="relative bg-gradient-to-b from-slate-100 to-indigo-50/50 p-5 text-center">
              <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold <%= item.available ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700' %>">
                <span class="h-1.5 w-1.5 rounded-full <%= item.available ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400' %>"></span>
                <%= item.available ? 'Available' : 'Paused' %>
              </span>
              <img
                class="mx-auto h-32 w-32 rounded-full object-cover border-4 border-white shadow-md bg-white"
                src="<%= item.image || '/assets/onelife-clinician-generated.png' %>"
                alt="Dr. <%= item.fullname %>"
              />
            </div>

            <!-- Body Information -->
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center gap-1.5">
                <h3 class="text-base font-bold text-slate-900">Dr. <%= item.fullname %></h3>
                <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] text-white font-bold" title="Verified Clinician">✓</span>
              </div>
              <p class="text-xs font-semibold text-primary mt-0.5"><%= item.speciality %></p>
              <p class="text-xs text-slate-500 mt-1"><%= item.degree || 'MBBS' %> · <%= item.experience ? `${item.experience} Years Exp.` : 'Experienced Specialist' %></p>
              
              <% if (item.about) { %>
                <p class="text-xs text-slate-600 mt-2 line-clamp-2 leading-relaxed"><%= item.about %></p>
              <% } %>

              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-500">Consultation Fee</span>
                <span class="text-sm font-extrabold text-slate-900">₹<%= item.fees || 500 %></span>
              </div>

              <a
                href="/appointment/<%= item._id %>"
                class="mt-4 block w-full rounded-xl bg-slate-900 py-2.5 text-center text-xs font-semibold text-white transition hover:bg-primary shadow-sm"
              >
                Book Appointment &rarr;
              </a>
            </div>
          </article>
        <% }); %>

        <% if (!filterDoc.length) { %>
          <div class="col-span-full rounded-2xl border border-dashed border-slate-300 p-12 text-center">
            <p class="text-lg font-bold text-slate-700">No doctors match this specialty yet.</p>
            <p class="text-xs text-slate-500 mt-1">Try selecting another department or explore all clinicians.</p>
            <a href="/doctors" class="mt-4 inline-block rounded-xl bg-primary px-5 py-2 text-xs font-semibold text-white">View All Clinicians</a>
          </div>
        <% } %>
      </div>

      <!-- No search match banner -->
      <div id="no-search-results" class="hidden rounded-2xl border border-dashed border-slate-300 p-12 text-center mt-6">
        <p class="text-base font-bold text-slate-700">No clinicians matched your search.</p>
        <p class="text-xs text-slate-500 mt-1">Try searching for a different doctor's name or clear the search input.</p>
      </div>
    </main>
  </div>
</div>

<script>
  // Real-time live client-side search filter
  const searchInput = document.getElementById('doctor-search');
  const cards = document.querySelectorAll('.doctor-card');
  const noResults = document.getElementById('no-search-results');

  searchInput?.addEventListener('input', (e) => {
    const term = e.target.value.toLowerCase().trim();
    let matches = 0;

    cards.forEach((card) => {
      const name = card.dataset.name || '';
      const speciality = card.dataset.speciality || '';
      const degree = card.dataset.degree || '';
      const isMatch = name.includes(term) || speciality.includes(term) || degree.includes(term);

      card.style.display = isMatch ? 'flex' : 'none';
      if (isMatch) matches++;
    });

    if (noResults) {
      noResults.classList.toggle('hidden', matches > 0 || cards.length === 0);
    }
  });
</script>

<%- include('partials/page-end') %>
