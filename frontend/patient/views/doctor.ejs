<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'Doctors - OneLife' }) %>

  <div>
    <p class="text-gray-600">Browse through the doctors specialist.</p>
    <div class="flex flex-col items-start gap-5 mt-5 sm:flex-row">
      <!-- Specialization Buttons -->
      <div class="flex flex-col gap-4 text-sm text-gray-600">
        <% const specialities = ['Gastroenterologist', 'Neurologist', 'Pediatricians', 'Dermatologist', 'General physician', 'Gynecologist']; %>
        <% specialities.forEach((name) => { %>
          <a
            href="<%= speciality === name ? '/doctors' : `/doctors/${encodeURIComponent(name)}` %>"
            class="w-[94vw] sm:w-auto pl-3 py-1.5 pr-16 border border-gray-300 rounded transition-all <%= speciality === name ? 'bg-indigo-100 text-black' : '' %>"
          ><%= name %></a>
        <% }) %>
      </div>

      <!-- Doctors Cards -->
      <div id="doctors-container" class="grid w-full gap-4 grid-cols-auto gap-y-6">
        <% filterDoc.forEach((item) => { %>
          <a href="/appointment/<%= item._id %>" class="border border-blue-200 rounded-xl overflow-hidden cursor-pointer hover:translate-y-[-10px] transition-all duration-500">
            <img
              class="bg-blue-50 hover:bg-primary"
              src="<%= item.image || '/assets/doc1.png' %>"
              alt="Dr. <%= item.fullname %>"
            />
            <div class="p-4">
              <div class="flex items-center gap-2 text-sm text-center text-green-500">
                <p class="w-2 h-2 rounded-full <%= item.available ? 'bg-green-500' : 'bg-gray-400' %>"></p>
                <p><%= item.available ? 'Available' : 'Currently unavailable' %></p>
              </div>
              <p class="text-lg font-medium text-gray-900"><%= item.fullname %></p>
              <p class="text-sm text-gray-600"><%= item.speciality %></p>
            </div>
          </a>
        <% }); %>
        <% if (!filterDoc.length) { %><p class="text-gray-500">No doctors match this specialty yet.</p><% } %>
      </div>
    </div>
  </div>
<%- include('partials/page-end') %>
