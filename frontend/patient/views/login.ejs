<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: state === 'register' ? 'Register - OneLife Hospital' : 'Sign In - OneLife Hospital' }) %>

<div class="py-12 max-w-md mx-auto">
  <!-- Demo Credentials Helper Banner for prospective buyers / evaluators -->
  <div class="mb-6 rounded-3xl border border-indigo-200/90 bg-gradient-to-r from-indigo-50/90 via-white to-blue-50/80 p-5 text-xs text-indigo-950 shadow-xs">
    <div class="flex items-center justify-between mb-1.5">
      <span class="font-bold flex items-center gap-2">
        <span class="flex h-5 w-5 items-center justify-center rounded-lg bg-primary text-white text-[10px]">⚡</span>
        <span>Commercial Demo Credentials</span>
      </span>
      <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-extrabold text-primary uppercase">1-Click Fill</span>
    </div>
    <p class="text-indigo-900/80 mb-2.5">Testing the platform for acquisition or deployment? Click below to auto-fill the demo patient account:</p>
    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        id="fill-demo-patient"
        class="rounded-xl border border-indigo-300 bg-white px-3 py-1.5 font-bold text-primary shadow-xs hover:bg-indigo-50 hover:border-primary transition"
      >
        Fill Patient Demo (sample@gmail.com)
      </button>
    </div>
    <div class="mt-3 text-[11px] text-slate-500 flex items-center justify-between border-t border-indigo-100 pt-2.5">
      <a href="/doctorlogin" class="font-semibold text-emerald-700 hover:underline">Doctor Workspace Login &rarr;</a>
      <a href="/admin/login" class="font-semibold text-indigo-700 hover:underline">Admin Console Login &rarr;</a>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div id="error-msg" role="alert" class="mb-6 rounded-2xl border border-rose-200 bg-rose-50 px-5 py-3 text-center text-xs font-bold text-rose-700 shadow-xs">
      <%= error %>
    </div>
  <% } %>

  <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-8 sm:p-10 shadow-xl">
    <div class="text-center mb-8">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-3xl bg-gradient-to-tr from-primary via-indigo-600 to-teal-500 text-white shadow-lg shadow-primary/25 mb-4">
        <img class="h-7 w-7 brightness-0 invert" src="/assets/onelife-mark.svg" alt="" />
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
        <%= state === 'register' ? 'Create Patient Account' : 'Welcome Back' %>
      </h1>
      <p class="text-xs text-slate-500 mt-1.5">
        <%= state === 'register' ? 'Register to manage appointments & telehealth consultations.' : 'Sign in to access your appointments and care team.' %>
      </p>
    </div>

    <form class="space-y-4" method="POST" action="<%= state === 'register' ? '/register' : '/login' %>">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

      <% if (state === 'register') { %>
        <div>
          <label for="fullname" class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Full Legal Name</label>
          <input
            type="text"
            id="fullname"
            name="fullname"
            autocomplete="name"
            value="<%= fullname || '' %>"
            placeholder="e.g. John Doe"
            required
            class="block w-full rounded-2xl border border-slate-300 bg-slate-50/80 px-4 py-3 text-xs font-semibold text-slate-900 placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-2xs transition"
          />
        </div>
      <% } %>

      <div>
        <label for="email" class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          value="<%= email || '' %>"
          placeholder="name@example.com"
          required
          class="block w-full rounded-2xl border border-slate-300 bg-slate-50/80 px-4 py-3 text-xs font-semibold text-slate-900 placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-2xs transition"
        />
      </div>

      <div>
        <label for="password" class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="<%= state === 'register' ? 'new-password' : 'current-password' %>"
          value="<%= password || '' %>"
          placeholder="••••••••"
          required
          class="block w-full rounded-2xl border border-slate-300 bg-slate-50/80 px-4 py-3 text-xs font-semibold text-slate-900 placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-2xs transition"
        />
        <% if (state === 'register') { %>
          <p class="mt-1 text-[11px] text-slate-400 font-medium">Must be at least 8 characters.</p>
        <% } %>
      </div>

      <button
        type="submit"
        class="w-full rounded-2xl bg-gradient-to-r from-primary to-indigo-600 py-3.5 text-xs font-bold text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:scale-[1.01] hover:shadow-glow-primary pt-3.5"
      >
        <%= state === 'register' ? 'Register Account' : 'Sign In Securely' %> &rarr;
      </button>

      <div class="pt-5 border-t border-slate-100 text-center text-xs text-slate-600">
        <% if (state === 'register') { %>
          Already registered?
          <a href="/login" class="font-bold text-primary hover:underline">Sign in here</a>
        <% } else { %>
          Don't have an account?
          <a href="/register" class="font-bold text-primary hover:underline">Create an account</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<script src="/assets/login-page.js"></script>
<script>
  // 1-Click Demo Fill for Evaluators
  document.getElementById('fill-demo-patient')?.addEventListener('click', () => {
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    if (emailInput && passwordInput) {
      emailInput.value = 'sample@gmail.com';
      passwordInput.value = 'password123';
      passwordInput.focus();
    }
  });
</script>

<%- include('partials/page-end') %>

