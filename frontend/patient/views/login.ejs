<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: state === 'register' ? 'Register - OneLife' : 'Login - OneLife' }) %>

<% if (typeof error !== 'undefined' && error) { %>
  <div id="error-msg" role="alert" class="mx-auto mt-5 max-w-md rounded-lg border border-red-300 bg-red-100 px-5 py-3 text-center font-medium text-red-700 shadow-sm">
    <%= error %>
  </div>
<% } %>

<form class="flex min-h-[80vh] items-center" method="POST" action="<%= state === 'register' ? '/register' : '/login' %>">
  <div class="mx-auto flex w-full max-w-md flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-8 text-sm text-gray-700 shadow-lg">
    <p class="text-3xl font-bold text-gray-900">
      <%= state === 'register' ? 'Create Account' : 'Login' %>
    </p>
    <p class="mb-2 text-gray-500">
      <%= state === 'register' ? 'Register to book an appointment.' : 'Sign in to book an appointment.' %>
    </p>

    <% if (state === 'register') { %>
      <div class="w-full">
        <label for="fullname" class="mb-1.5 block">Full Name</label>
        <input
          type="text"
          id="fullname"
          name="fullname"
          autocomplete="name"
          value="<%= fullname || '' %>"
          required
          class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
        />
      </div>
    <% } %>

    <div class="w-full">
      <label for="email" class="mb-1.5 block">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        autocomplete="email"
        value="<%= email || '' %>"
        required
        class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      />
    </div>

    <div class="w-full">
      <label for="password" class="mb-1.5 block">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        autocomplete="<%= state === 'register' ? 'new-password' : 'current-password' %>"
        value="<%= password || '' %>"
        required
        class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      />
    </div>

    <button
      type="submit"
      class="mt-2 w-full rounded-lg bg-primary px-4 py-3 text-base font-semibold text-white shadow-md transition hover:bg-gray-700"
    >
      <%= state === 'register' ? 'Create Account' : 'Login' %>
    </button>

    <% if (state === 'register') { %>
      <p class="text-sm">
        Already have an account? 
        <a href="/login" class="text-primary underline">Login here</a>
      </p>
    <% } else { %>
      <p class="text-sm">
        Create a new account? 
        <a href="/register" class="text-primary underline">Click here</a>
      </p>
    <% } %>
  </div>
</form>
<script src="/assets/login-page.js"></script>
<%- include('partials/page-end') %>
