<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: state === 'register' ? 'Register - OneLife Hospital' : 'Sign In - OneLife Hospital' }) %>

<div class="py-12 max-w-md mx-auto">
  <!-- Demo Credentials Helper Banner for prospective buyers / evaluators -->
  <div class="mb-6 rounded-2xl border border-indigo-200 bg-indigo-50/70 p-4 text-xs text-indigo-950 shadow-sm">
    <div class="flex items-center justify-between mb-1">
      <span class="font-bold flex items-center gap-1.5">⚡ Commercial Demo Credentials</span>
      <span class="rounded bg-indigo-200/60 px-1.5 py-0.5 text-[10px] font-bold">1-Click Fill</span>
    </div>
    <p class="text-indigo-900/80 mb-2">Testing the platform? Click below to auto-fill the demo patient account:</p>
    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        id="fill-demo-patient"
        class="rounded-lg border border-indigo-300 bg-white px-2.5 py-1 font-semibold text-primary shadow-sm hover:bg-indigo-50 transition"
      >
        Fill Patient Demo (sample@gmail.com)
      </button>
    </div>
    <div class="mt-2 text-[11px] text-slate-500 flex items-center justify-between border-t border-indigo-100 pt-2">
      <a href="/doctorlogin" class="underline hover:text-primary">Doctor Workspace Login &rarr;</a>
      <a href="/admin/login" class="underline hover:text-primary">Admin Console Login &rarr;</a>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div id="error-msg" role="alert" class="mb-6 rounded-2xl border border-rose-200 bg-rose-50 px-5 py-3 text-center text-xs font-semibold text-rose-700 shadow-sm">
      <%= error %>
    </div>
  <% } %>

  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white p-8 shadow-xl">
    <div class="text-center mb-6">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-tr from-primary to-indigo-600 text-white shadow-md mb-3">
        <img class="h-6 w-6 brightness-0 invert" src="/assets/onelife-mark.svg" alt="" />
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900">
        <%= state === 'register' ? 'Create Patient Account' : 'Welcome Back' %>
      </h1>
      <p class="text-xs text-slate-500 mt-1">
        <%= state === 'register' ? 'Register to manage appointments & telehealth consultations.' : 'Sign in to access your appointments and care team.' %>
      </p>
    </div>

    <form class="space-y-4" method="POST" action="<%= state === 'register' ? '/register' : '/login' %>">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

      <% if (state === 'register') { %>
        <div>
          <label for="fullname" class="block text-xs font-semibold text-slate-700 mb-1">Full Legal Name</label>
          <input
            type="text"
            id="fullname"
            name="fullname"
            autocomplete="name"
            value="<%= fullname || '' %>"
            placeholder="e.g. John Doe"
            required
            class="block w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-xs text-slate-900 placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
        </div>
      <% } %>

      <div>
        <label for="email" class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          value="<%= email || '' %>"
          placeholder="name@example.com"
          required
          class="block w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-xs text-slate-900 placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
        />
      </div>

      <div>
        <label for="password" class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="<%= state === 'register' ? 'new-password' : 'current-password' %>"
          value="<%= password || '' %>"
          placeholder="••••••••"
          required
          class="block w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-xs text-slate-900 placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
        />
        <% if (state === 'register') { %>
          <p class="mt-1 text-[11px] text-slate-400">Must be at least 8 characters.</p>
        <% } %>
      </div>

      <button
        type="submit"
        class="w-full rounded-xl bg-primary py-3 text-xs font-bold text-white shadow-md shadow-primary/25 transition hover:bg-indigo-600 hover:shadow-lg pt-3"
      >
        <%= state === 'register' ? 'Register Account' : 'Sign In Securely' %> &rarr;
      </button>

      <div class="pt-4 border-t border-slate-100 text-center text-xs text-slate-600">
        <% if (state === 'register') { %>
          Already registered?
          <a href="/login" class="font-bold text-primary hover:underline">Sign in here</a>
        <% } else { %>
          Don't have an account?
          <a href="/register" class="font-bold text-primary hover:underline">Create an account</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<script src="/assets/login-page.js"></script>
<script>
  // 1-Click Demo Fill for Evaluators
  document.getElementById('fill-demo-patient')?.addEventListener('click', () => {
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    if (emailInput && passwordInput) {
      emailInput.value = 'sample@gmail.com';
      passwordInput.value = 'password123';
      passwordInput.focus();
    }
  });
</script>

<%- include('partials/page-end') %>
