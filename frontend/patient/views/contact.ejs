<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'Contact Hospital & Care Team - OneLife' }) %>

<div class="py-8 max-w-5xl mx-auto">
  <!-- Header -->
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="inline-block rounded-full bg-primary/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-primary">Get In Touch</span>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2">We Are Here to Assist Your Care</h1>
    <p class="text-xs sm:text-sm text-slate-600 mt-2">Have a question about appointment scheduling, doctor availability, or hospital services? Reach out directly.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
    <!-- Left Column: Hospital Info & Cards (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Phone Helpline -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-primary text-xl mb-3">📞</div>
          <h2 class="text-sm font-bold text-slate-900">Hospital Helpline</h2>
          <p class="text-xs text-slate-500 mt-1">Available 24/7 for appointments &amp; admissions</p>
          <a href="tel:+919399304021" class="mt-3 inline-block font-extrabold text-sm text-primary hover:underline">+91 93993 04021</a>
        </div>

        <!-- Email Support -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50 text-teal-600 text-xl mb-3">✉️</div>
          <h2 class="text-sm font-bold text-slate-900">Email Inquiry</h2>
          <p class="text-xs text-slate-500 mt-1">Medical desk &amp; administrative records</p>
          <a href="mailto:support@onelife.health" class="mt-3 inline-block font-bold text-xs text-teal-700 hover:underline truncate max-w-full">support@onelife.health</a>
        </div>
      </div>

      <!-- Campus Location Card -->
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">🏥</span>
          <h2 class="text-base font-bold text-slate-900">OneLife Central Hospital Campus</h2>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          OneLife Multispecialty Medical Center &amp; Research Institute<br />
          Mahavir Colony, Satna, Madhya Pradesh, India 485001
        </p>
        <div class="pt-2 border-t border-slate-100 flex flex-wrap gap-4 text-xs text-slate-500">
          <span>🕒 Outpatient Clinics: <strong>09:00 AM – 06:00 PM</strong></span>
          <span>🚨 Emergency &amp; Trauma: <strong>24 Hours Open</strong></span>
        </div>
      </div>

      <!-- Emergency Disclaimer -->
      <div class="rounded-2xl border border-rose-200 bg-rose-50/80 p-5 text-xs text-rose-900 space-y-1">
        <p class="font-bold flex items-center gap-1.5 text-rose-800">
          <span>⚠️</span> Acute Medical Emergency Disclaimer
        </p>
        <p class="leading-relaxed">
          Do not use web forms for critical, immediate life-threatening events. For heart attacks, stroke symptoms, acute shortness of breath, or trauma, contact emergency ambulance services (<strong>112 / 911</strong>) right away.
        </p>
      </div>
    </div>

    <!-- Right Column: Visual & Direct Support Action (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-900 shadow-xl">
        <img class="h-64 w-full object-cover object-top" src="/assets/onelife-team-generated.png" alt="OneLife Medical Care Team" />
        <div class="p-6 text-white space-y-3">
          <h2 class="text-lg font-bold">Online Patient Support Portal</h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            Registered patients can create threaded support tickets, query invoices, or request medical report re-issues directly from their personal dashboard.
          </p>
          <a
            href="<%= user ? '/messages' : '/login' %>"
            class="inline-block w-full rounded-xl bg-primary py-3 text-center text-xs font-bold text-white shadow-md hover:bg-indigo-600 transition"
          >
            <%= user ? 'Open Support Dashboard &rarr;' : 'Sign In to Contact Support &rarr;' %>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/page-end') %>
