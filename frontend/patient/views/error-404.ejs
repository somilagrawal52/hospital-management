<%- include('head') %>
<div class="mx-4 sm:mx-[10%] min-h-screen flex items-center justify-center">
  <div class="max-w-lg text-center bg-white border border-gray-200 rounded-2xl shadow-lg p-10">
    <p class="text-sm uppercase tracking-[0.3em] text-gray-400">Error</p>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900"><%= title || "Page Not Found" %></h1>
    <p class="mt-4 text-gray-600"><%= message || "The page you requested could not be found." %></p>
    <div class="mt-8">
      <a
        href="/"
        class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white rounded-lg bg-primary hover:bg-gray-700 transition"
      >
        Return Home
      </a>
    </div>
  </div>
</div>
<%- include('bottom') %>
