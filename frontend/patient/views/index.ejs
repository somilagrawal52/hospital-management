<%- include('partials/page-start', { includeHeroHeader: true, pageTitle: 'OneLife - Modern Hospital & Telehealth Platform' }) %>

<!-- Commercial Sales Demo Quick Access Bar (Collapsible / Non-intrusive) -->
<div class="mb-12 rounded-3xl border border-indigo-200/80 bg-gradient-to-r from-indigo-50/90 via-white to-blue-50/80 p-5 shadow-sm backdrop-blur-md">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-start gap-3.5">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-tr from-primary to-indigo-600 text-white shadow-md shadow-primary/25 text-base">
        ⚡
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-sm font-bold text-slate-900">Commercial Evaluation &amp; Demo Access</h2>
          <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-extrabold text-primary uppercase tracking-wide">Evaluator Mode</span>
        </div>
        <p class="text-xs text-slate-600 mt-0.5">Evaluating this platform for hospital acquisition or deployment? Instant 1-click test roles are pre-configured:</p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/admin/login" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-800 shadow-xs hover:border-primary hover:text-primary transition-all duration-200 hover:-translate-y-0.5">
        <span>⚙️ Admin Console</span>
      </a>
      <a href="/doctorlogin" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-800 shadow-xs hover:border-emerald-600 hover:text-emerald-700 transition-all duration-200 hover:-translate-y-0.5">
        <span>🩺 Doctor Portal</span>
      </a>
      <a href="/login" class="inline-flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-3.5 py-2 text-xs font-bold text-white shadow-md shadow-primary/25 hover:opacity-95 transition-all duration-200 hover:-translate-y-0.5">
        <span>👤 Patient Portal</span>
      </a>
    </div>
  </div>
</div>

<!-- Specialities Section -->
<section class="py-8" id="speciality">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="inline-block rounded-full bg-indigo-50 border border-indigo-100/80 px-4 py-1 text-xs font-bold uppercase tracking-wider text-primary shadow-xs">Clinical Specializations</span>
    <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">Find Doctors by Medical Specialty</h2>
    <p class="text-sm text-slate-600 mt-2.5">Select a clinical discipline to explore board-certified specialists, examine verified credentials, and book consultation slots.</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6">
    <% if (specialityData && specialityData.length > 0) { %>
      <% specialityData.forEach((item, index) => { %>
        <a
          href="/doctors/<%= encodeURIComponent(item.speciality) %>"
          class="group flex flex-col items-center text-center p-6 rounded-3xl border border-slate-200/90 bg-white shadow-xs transition-all duration-300 hover:shadow-xl hover:border-primary/60 hover:-translate-y-1.5"
          key="<%= index %>"
        >
          <div class="h-20 w-20 rounded-2xl bg-gradient-to-tr from-indigo-50 to-slate-50 p-3.5 mb-3.5 flex items-center justify-center transition-all duration-300 group-hover:bg-primary group-hover:shadow-glow-primary group-hover:scale-105">
            <img class="h-12 w-12 object-contain transition-all duration-300 group-hover:brightness-0 group-hover:invert" src="<%= item.image %>" alt="<%= item.speciality %>" />
          </div>
          <h3 class="text-sm font-bold text-slate-900 group-hover:text-primary transition-colors"><%= item.speciality %></h3>
          <p class="text-[11px] text-slate-500 mt-1 line-clamp-2 leading-relaxed"><%= item.description || 'Specialist consultations & care' %></p>
          <span class="mt-3 text-[11px] font-bold text-primary opacity-0 group-hover:opacity-100 transition-opacity">Browse Doctors &rarr;</span>
        </a>
      <% }) %>
    <% } else { %>
      <p class="col-span-full text-center text-sm text-slate-500">No specialties found.</p>
    <% } %>
  </div>
</section>

<!-- Top Clinicians Showcase -->
<section class="py-14">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
    <div>
      <span class="inline-block rounded-full bg-emerald-50 border border-emerald-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-800">Verified Medical Faculty</span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2.5 tracking-tight">Available Clinicians &amp; Specialists</h2>
      <p class="text-sm text-slate-600 mt-1.5">Schedule instant in-clinic visits or launch high-definition video consultations.</p>
    </div>
    <a href="/doctors" class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-indigo-700 transition">
      <span>View All Clinicians</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <% if (locals.doctors && doctors.length > 0) { %>
      <% doctors.forEach((doc) => { %>
        <article class="flex flex-col overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-xs transition-all duration-300 hover:shadow-xl hover:border-primary/50 hover:-translate-y-1.5 group">
          <!-- Doctor Photo Header -->
          <div class="relative bg-gradient-to-b from-indigo-50/60 to-slate-100 p-5 text-center">
            <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold <%= doc.available ? 'bg-emerald-100/90 text-emerald-800 ring-1 ring-emerald-500/20' : 'bg-slate-200 text-slate-700' %>">
              <span class="h-1.5 w-1.5 rounded-full <%= doc.available ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400' %>"></span>
              <%= doc.available ? 'Available' : 'Paused' %>
            </span>
            <div class="relative inline-block">
              <img
                class="mx-auto h-36 w-36 rounded-full object-cover border-4 border-white shadow-lg bg-white transition duration-300 group-hover:scale-105"
                src="<%= doc.image || '/assets/onelife-clinician-generated.png' %>"
                alt="Dr. <%= doc.fullname %>"
              />
            </div>
          </div>

          <!-- Doctor Body -->
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <h3 class="text-base font-bold text-slate-900 group-hover:text-primary transition-colors">Dr. <%= doc.fullname %></h3>
                <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] text-white font-bold" title="Verified Clinician">✓</span>
              </div>
              <div class="flex items-center text-xs font-bold gap-0.5">
                <% if (doc.ratingCount > 0) { %>
                  <span class="text-amber-400">★</span>
                  <span class="text-slate-800 text-[11px]"><%= Number(doc.ratingAverage).toFixed(1) %> (<%= doc.ratingCount %>)</span>
                <% } else { %>
                  <span class="rounded-md bg-emerald-50 px-1.5 py-0.5 text-[10px] text-emerald-700">Verified</span>
                <% } %>
              </div>
            </div>
            
            <p class="text-xs font-bold text-primary mt-1"><%= doc.speciality %></p>
            <p class="text-xs text-slate-500 mt-0.5"><%= doc.degree || 'MBBS, MD' %> · <%= doc.experience ? `${doc.experience} Years Exp.` : 'Senior Consultant' %></p>
            
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500">Consultation Fee</span>
              <div class="text-right">
                <span class="text-base font-extrabold text-slate-900">₹<%= doc.fees || 500 %></span>
                <span class="block text-[10px] text-emerald-600 font-semibold">Zero Booking Fee</span>
              </div>
            </div>

            <a
              href="/appointment/<%= doc._id %>"
              class="mt-4 flex items-center justify-center gap-1.5 w-full rounded-2xl bg-slate-900 py-3 text-center text-xs font-bold text-white transition-all duration-300 group-hover:bg-primary shadow-xs"
            >
              <span>Book Consultation</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      <% }); %>
    <% } else { %>
      <div class="col-span-full rounded-3xl border border-dashed border-slate-300 p-10 text-center text-sm text-slate-500">
        Clinicians are currently loading. Browse all clinicians via the directory.
      </div>
    <% } %>
  </div>
</section>

