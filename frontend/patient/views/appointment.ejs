<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'Book Appointment - OneLife' }) %>

  <% if (docInfo) { %>
    <div>
      <!-- Doctor Details -->
      <div class="flex flex-col gap-4 mb-12 sm:flex-row">
        <div class="sm:w-1/3">
          <img 
            class="rounded-lg shadow-md bg-primary sm:max-w-72" 
            src="<%= docInfo.image %>" 
            alt="<%= docInfo.fullname %>" 
          />
        </div>
        <div class="flex-1 p-8 bg-white border border-gray-200 rounded-lg shadow-lg py-7">
          <!-- Doctor Info -->
          <p class="flex items-center gap-2 text-2xl font-semibold text-gray-900">Dr.
            <%= docInfo.fullname %> 
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-primary text-xs text-white" aria-label="Verified">✓</span>
          </p>
          <div class="flex items-center gap-3 mt-2 text-sm text-gray-600">
            <p class="font-medium"><%= `${docInfo.degree} - ${docInfo.speciality}` %></p>
            <span class="px-3 py-1 text-sm bg-gray-100 border rounded-full gray-500 text-">
              <%= docInfo.experience %> Years
            </span>
          </div>
          <!-- Doctor About -->
          <div class="mt-4">
            <p class="flex items-center gap-2 text-sm font-medium text-gray-800">
              About <span class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-gray-500 text-[10px] text-gray-500" aria-label="Information">i</span>
            </p>
            <p class="mt-2 text-sm leading-relaxed text-gray-600"><%= docInfo.about %></p>
          </div>
          <p class="mt-6 font-medium text-gray-600">
            Appointment fee: <span class="font-semibold text-gray-800">₹<%= docInfo.fees %></span>
          </p>
        </div>
      </div>

      <!-- Booking Slots -->
      <p class="mb-6 text-lg font-semibold text-gray-800">Book An Appointment</p>
      <div class="p-8 text-gray-700 bg-white border rounded-lg shadow-lg">
       
        <form id="appointmentForm"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
          <!-- Patient Details -->
          <div class="mb-5">
            <label for="fullname" class="block mb-2 text-sm font-medium text-gray-800">Full Name</label>
            <input
              type="text"
              class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-primary focus:border-primary"
              id="fullname"
              name="fullname"
              placeholder="Enter your full name"
              required
            />
          </div>
          <div class="mb-5">
            <label for="email" class="block mb-2 text-sm font-medium text-gray-800">Email</label>
            <input
              type="email"
              class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-primary focus:border-primary"
              id="email"
              name="email"
              placeholder="Enter your email"
              required
            />
          </div>
          <div class="mb-5">
            <label for="number" class="block mb-2 text-sm font-medium text-gray-800">Phone Number</label>
            <input
              type="text"
              class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-primary focus:border-primary"
              id="number"
              name="number"
              placeholder="Enter your phone number"
              required
            />
          </div>

          <!-- Appointment Details -->
          <div class="mb-5">
            <label for="doctor" class="block mb-2 text-sm font-medium text-gray-800">Doctor</label>
            <input id="doctor" type="text" class="block w-full border-gray-300 rounded-lg bg-gray-50 shadow-sm" value="Dr. <%= docInfo.fullname %>" readonly>
            <input type="hidden" name="docId" value="<%= docInfo._id %>">
          </div>
          <div class="mb-5">
            <label for="date" class="block w-full mb-2 text-sm font-medium text-gray-800">Date</label>
            <input
              type="date"
              class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-primary focus:border-primary"
              id="date"
              name="date"
              required
            />
          </div>

          <div class="mb-5">
            <label for="time" class="block w-full mb-2 text-sm font-medium text-gray-800">Preferred time</label>
            <select id="time" name="time" required disabled class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-primary focus:border-primary">
              <option value="">Choose a date first</option>
            </select>
            <p id="slot-message" class="mt-1 text-xs text-gray-500">Select a date to load real-time available slots. Your appointment is confirmed only after successful payment.</p>
          </div>

          <% if (user) { %>
            <div id="waitlist-panel" class="hidden mb-5 rounded-lg border border-amber-200 bg-amber-50 p-4">
              <p class="text-sm font-semibold text-amber-900">No convenient slot?</p>
              <p class="mt-1 text-xs text-amber-800">Join the waitlist and we will email you if a slot opens for the selected date.</p>
              <button id="join-waitlist" type="button" class="mt-3 rounded border border-amber-400 bg-white px-3 py-2 text-sm font-medium text-amber-900 hover:bg-amber-100">Join waitlist</button>
            </div>
          <% } %>

          <div class="mb-5">
            <label for="address" class="block mb-2 text-sm font-medium text-gray-800">Address</label>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="line1" class="text-sm text-gray-600">Line 1</label>
                <input
                  type="text"
                  class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-primary focus:border-primary"
                  id="line1"
                  name="line1"
                  placeholder="Street address"
                  required
                />
              </div>
              <div>
                <label for="line2" class="text-sm text-gray-600">Line 2</label>
                <input
                  type="text"
                  class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-primary focus:border-primary"
                  id="line2"
                  name="line2"
                  placeholder="City, State"
                  required
                />
              </div>
            </div>
          </div>

          <div class="mb-5">
            <label for="amount" class="block mb-2 text-sm font-medium text-gray-800">Payment Amount (₹)</label>
            <input
              type="text"
              class="block w-full border-gray-300 rounded-lg shadow-sm focus:ring-primary focus:border-primary"
              id="amount"
              name="amount"
              value="<%= docInfo.fees %>"
              placeholder="<%= docInfo.fees %>"
              readonly
            />
          </div>
         <% if (user){ %>
         <button
            id="book-btn"
            type="submit"
            class="w-full py-3 text-sm font-semibold text-white transition rounded-lg bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary-light focus:ring-offset-2"
          >
            Submit & Pay
          </button>
         <% }else{ %>
          <a
            href="/login"
            class="block w-full py-3 text-sm font-semibold text-center text-white transition rounded-lg bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary-light focus:ring-offset-2"
          >Sign in to book &amp; pay</a>
         <% } %>
          
          
          <!-- Buttons -->
          
        </form>
      </div>
      <p class="mt-5 text-xs leading-5 text-gray-500">For medical emergencies, contact your local emergency service. This platform does not provide emergency care.</p>
    </div>
  <% } %>
</div>
<% if (typeof integrationMode === 'undefined' || integrationMode === 'live') { %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<% } else if (integrationMode === 'mock') { %>
<script src="/console-assets/js/mock-checkout.js"></script>
<% } %>
<script>window.RAZORPAY_KEY = '<%= razorpayKey || "" %>';</script>
<script>window.DOCTOR_ID = '<%= docInfo ? docInfo._id : "" %>';</script>
<script src="/assets/appointment-page.js"></script>
<%- include('partials/page-end') %>
