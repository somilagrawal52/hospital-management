<% const safeReviews = typeof reviews !== 'undefined' ? reviews : []; const safeComplaint = typeof prefillComplaint !== 'undefined' ? prefillComplaint : ''; %>
<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'Book Appointment - OneLife' }) %>

<div class="py-8">
  <% if (docInfo) { %>
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs text-slate-500 mb-8 font-medium">
      <a href="/" class="hover:text-primary transition">Home</a>
      <span class="text-slate-400">/</span>
      <a href="/doctors" class="hover:text-primary transition">Clinicians</a>
      <span class="text-slate-400">/</span>
      <span class="text-slate-900 font-bold">Dr. <%= docInfo.fullname %></span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Doctor Profile & Fee Overview (5 cols) -->
      <aside class="lg:col-span-5 space-y-6">
        <div class="rounded-3xl border border-slate-200/90 bg-white p-7 shadow-xs">
          <!-- Doctor Card Header -->
          <div class="flex flex-col sm:flex-row lg:flex-col items-center gap-5 text-center sm:text-left lg:text-center pb-6 border-b border-slate-100">
            <div class="relative">
              <img
                class="h-32 w-32 rounded-3xl object-cover border-4 border-indigo-50/80 shadow-lg bg-slate-50"
                src="<%= docInfo.image %>"
                alt="Dr. <%= docInfo.fullname %>"
              />
              <span class="absolute -bottom-2 -right-2 flex h-7 w-7 items-center justify-center rounded-full bg-primary text-white text-xs font-bold shadow-md ring-2 ring-white" title="Verified Clinician">
                ✓
              </span>
            </div>
            <div>
              <div class="flex items-center justify-center sm:justify-start lg:justify-center gap-1.5">
                <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Dr. <%= docInfo.fullname %></h1>
              </div>
              <p class="text-xs font-bold text-primary mt-1"><%= docInfo.speciality %></p>
              <div class="mt-2.5 flex flex-wrap items-center justify-center sm:justify-start lg:justify-center gap-2 text-xs">
                <span class="rounded-xl bg-slate-100 px-3 py-1 font-semibold text-slate-700"><%= docInfo.degree || 'MBBS' %></span>
                <span class="rounded-xl bg-indigo-50 px-3 py-1 font-bold text-primary"><%= docInfo.experience ? `${docInfo.experience} Years Experience` : 'Senior Consultant' %></span>
                <% if (docInfo.ratingCount > 0) { %>
                  <span class="rounded-xl bg-amber-50 px-2.5 py-1 font-bold text-amber-800 flex items-center gap-1">★ <%= Number(docInfo.ratingAverage).toFixed(1) %> (<%= docInfo.ratingCount %>)</span>
                <% } else { %>
                  <span class="rounded-xl bg-emerald-50 px-2.5 py-1 font-bold text-emerald-700">✓ Verified Clinician</span>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Doctor Bio / About -->
          <div class="py-5 border-b border-slate-100">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-2">About Clinician</h2>
            <p class="text-xs leading-relaxed text-slate-600"><%= docInfo.about || 'Dedicated specialist providing comprehensive diagnostics and patient-centric healthcare.' %></p>
          </div>

          <!-- Clinic / Hospital Location -->
          <div class="py-5 border-b border-slate-100 text-xs text-slate-600 space-y-1">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-2">Practice Location</h3>
            <p class="font-bold text-slate-900"><%= (docInfo.address && docInfo.address.line1) || 'OneLife Central Hospital, Wing A' %></p>
            <p><%= (docInfo.address && docInfo.address.line2) || 'Consultation Suite 402' %></p>
            <div class="pt-2 flex items-center gap-2 text-[11px] text-emerald-700 font-semibold">
              <span>●</span> <span>Available for In-Clinic &amp; HD Telehealth</span>
            </div>
          </div>

          <!-- Consultation Fee Breakdown -->
          <div class="pt-5 space-y-3">
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>Standard Consultation Fee</span>
              <span class="font-bold text-slate-900">₹<%= docInfo.fees %></span>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>HD Telehealth &amp; Calendar Invite</span>
              <span class="font-semibold text-emerald-600">Free Included</span>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>Automated GST Tax Invoice</span>
              <span class="font-semibold text-slate-700">Instant PDF</span>
            </div>
            <div class="flex items-center justify-between border-t border-slate-100 pt-3.5 text-sm font-bold text-slate-900">
              <span>Total Payable</span>
              <span class="text-xl font-extrabold text-primary">₹<%= docInfo.fees %></span>
            </div>
          </div>
        </div>

        <!-- Security & Guarantee Notice -->
        <div class="rounded-3xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-5 text-xs text-slate-600 space-y-2 shadow-xs">
          <div class="flex items-center gap-2 font-bold text-slate-900">
            <span class="text-base">🛡️</span> Bank-Grade Secure Payment
          </div>
          <p class="leading-relaxed">Processed securely via Razorpay with instant OPD token generation, 10-minute slot hold protection, calendar invite, and GST tax receipt.</p>
        </div>

        <% if (safeReviews.length) { %>
          <div class="rounded-3xl border border-slate-200 bg-white p-6 space-y-3 shadow-xs">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Verified Patient Reviews</h3>
              <span class="text-xs font-bold text-amber-700">★ <%= Number(docInfo.ratingAverage || 5).toFixed(1) %></span>
            </div>
            <div class="space-y-3">
              <% safeReviews.slice(0, 3).forEach((rev) => { %>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/80 p-3.5 text-xs space-y-1">
                  <div class="flex items-center justify-between">
                    <strong class="text-slate-900"><%= rev.patientName %></strong>
                    <span class="text-amber-500 font-bold">★ <%= rev.rating %>/5</span>
                  </div>
                  <% if (rev.comment) { %><p class="text-slate-600 leading-relaxed"><%= rev.comment %></p><% } %>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </aside>

      <!-- Right Column: Booking Slot & Patient Details Form (7 cols) -->
      <main class="lg:col-span-7">
        <div class="rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs">
          <div class="border-b border-slate-100 pb-5 mb-6">
            <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Reserve Consultation Slot</h2>
            <p class="text-xs text-slate-500 mt-1">Select a consultation date to view real-time open slots and complete your appointment booking.</p>
          </div>

          <form id="appointmentForm" class="space-y-6">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
            <input type="hidden" name="docId" value="<%= docInfo._id %>" />
            <input type="hidden" id="amount" name="amount" value="<%= docInfo.fees %>" />

            <!-- Consultation Type Selector -->
            <div class="rounded-2xl border border-slate-200 p-4 bg-slate-50/50">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-900 mb-2.5">Consultation Mode</label>
              <div class="grid grid-cols-2 gap-3 text-xs font-semibold">
                <label class="flex items-center gap-2.5 p-3 rounded-xl border border-indigo-200 bg-indigo-50/80 text-primary cursor-pointer transition">
                  <input type="radio" name="consultationMode" value="clinic" checked class="text-primary focus:ring-primary" />
                  <div>
                    <p class="font-bold">🏥 In-Clinic Visit</p>
                    <p class="text-[10px] text-slate-500 font-normal">At Hospital Consultation Suite</p>
                  </div>
                </label>
                <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-white text-slate-700 cursor-pointer hover:border-slate-300 transition">
                  <input type="radio" name="consultationMode" value="telehealth" class="text-primary focus:ring-primary" />
                  <div>
                    <p class="font-bold">📹 HD Telehealth</p>
                    <p class="text-[10px] text-slate-500 font-normal">Encrypted Video Call Link</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Date & Time Slot Picker -->
            <div class="rounded-2xl bg-slate-50 p-5 border border-slate-200 space-y-4">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">1. Select Appointment Date &amp; Slot</h3>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="date" class="block text-xs font-semibold text-slate-700 mb-1.5">Consultation Date</label>
                  <input
                    type="date"
                    id="date"
                    name="date"
                    class="block w-full rounded-xl border border-slate-300 bg-white text-xs font-semibold text-slate-900 shadow-xs focus:border-primary focus:ring-2 focus:ring-primary/20 py-2.5 px-3"
                    required
                  />
                </div>

                <div>
                  <label for="time" class="block text-xs font-semibold text-slate-700 mb-1.5">Available Slot Time</label>
                  <select
                    id="time"
                    name="time"
                    disabled
                    class="block w-full rounded-xl border border-slate-300 bg-white text-xs font-semibold text-slate-900 shadow-xs focus:border-primary focus:ring-2 focus:ring-primary/20 py-2.5 px-3"
                    required
                  >
                    <option value="">Choose a date first</option>
                  </select>
                </div>
              </div>

              <!-- Slot status message -->
              <p id="slot-message" class="text-xs text-slate-500 font-medium">Choose a calendar date to check live clinician availability.</p>

              <!-- Waitlist Notification Card -->
              <div id="waitlist-panel" class="hidden rounded-2xl border border-amber-300 bg-amber-50 p-4 space-y-2">
                <div class="flex items-center gap-2 font-bold text-xs text-amber-900">
                  <span>⏰</span> No convenient slot available for this date?
                </div>
                <p class="text-xs text-amber-800 leading-relaxed">Join the automated waitlist. When another patient cancels or reschedules, OneLife will immediately notify you by email.</p>
                <% if (user) { %>
                  <button id="join-waitlist" type="button" class="rounded-xl border border-amber-400 bg-white px-3.5 py-1.5 text-xs font-bold text-amber-900 hover:bg-amber-100 shadow-xs transition">
                    Join Waiting List
                  </button>
                <% } else { %>
                  <a href="/login" class="inline-block rounded-xl border border-amber-400 bg-white px-3.5 py-1.5 text-xs font-bold text-amber-900 hover:bg-amber-100 shadow-xs">
                    Sign in to join waitlist
                  </a>
                <% } %>
              </div>
            </div>

            <!-- Family Member / Patient Selection -->
            <% if (locals.patientdata && patientdata.dependents && patientdata.dependents.length > 0) { %>
              <div class="rounded-2xl border border-indigo-200/80 bg-indigo-50/40 p-4 space-y-2">
                <label for="memberId" class="block text-xs font-bold uppercase tracking-wider text-slate-900">Who Is This Consultation For?</label>
                <select id="memberId" name="memberId" class="block w-full rounded-xl border border-slate-300 bg-white text-xs font-semibold text-slate-900 py-2.5 px-3">
                  <option value="self" data-allergies="<%= patientdata.allergies || '' %>">Self (<%= patientdata.fullname %>)</option>
                  <% patientdata.dependents.forEach((dep) => { %>
                    <option value="<%= dep._id %>" data-allergies="<%= dep.allergies || '' %>"><%= dep.fullname %> (<%= dep.relation %>)</option>
                  <% }) %>
                </select>
              </div>
            <% } %>

            <!-- Patient Information -->
            <div class="space-y-4">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">2. Patient Contact Details</h3>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="fullname" class="block text-xs font-semibold text-slate-700 mb-1">Patient Full Name</label>
                  <input
                    type="text"
                    id="fullname"
                    name="fullname"
                    value="<%= (locals.patientdata && patientdata.fullname) ? patientdata.fullname : '' %>"
                    placeholder="e.g. John Doe"
                    class="block w-full rounded-xl border border-slate-300 text-xs text-slate-900 shadow-xs focus:border-primary focus:ring-2 focus:ring-primary/20 py-2.5 px-3"
                    required
                  />
                </div>

                <div>
                  <label for="email" class="block text-xs font-semibold text-slate-700 mb-1">Email (For Invoice &amp; Video Link)</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    value="<%= (locals.patientdata && patientdata.email) ? patientdata.email : '' %>"
                    placeholder="patient@example.com"
                    class="block w-full rounded-xl border border-slate-300 text-xs text-slate-900 shadow-xs focus:border-primary focus:ring-2 focus:ring-primary/20 py-2.5 px-3"
                    required
                  />
                </div>
              </div>

              <div>
                <label for="number" class="block text-xs font-semibold text-slate-700 mb-1">Phone Number</label>
                <input
                  type="tel"
                  id="number"
                  name="number"
                  value="<%= (locals.patientdata && patientdata.number) ? patientdata.number : '' %>"
                  placeholder="e.g. 9876543210"
                  class="block w-full rounded-xl border border-slate-300 text-xs text-slate-900 shadow-xs focus:border-primary focus:ring-2 focus:ring-primary/20 py-2.5 px-3"
                  required
                />
              </div>
            </div>

            <!-- Address Fields -->
            <div class="space-y-4">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">3. Residential Address</h3>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="line1" class="block text-xs font-semibold text-slate-700 mb-1">Street Address / Line 1</label>
                  <input
                    type="text"
                    id="line1"
                    name="line1"
                    value="<%= (locals.patientdata && patientdata.address && patientdata.address.line1) ? patientdata.address.line1 : '' %>"
                    placeholder="House / Flat / Street"
                    class="block w-full rounded-xl border border-slate-300 text-xs text-slate-900 shadow-xs focus:border-primary focus:ring-2 focus:ring-primary/20 py-2.5 px-3"
                    required
                  />
                </div>

                <div>
                  <label for="line2" class="block text-xs font-semibold text-slate-700 mb-1">City, State / Line 2</label>
                  <input
                    type="text"
                    id="line2"
                    name="line2"
                    value="<%= (locals.patientdata && patientdata.address && patientdata.address.line2) ? patientdata.address.line2 : '' %>"
                    placeholder="City, State, PIN"
                    class="block w-full rounded-xl border border-slate-300 text-xs text-slate-900 shadow-xs focus:border-primary focus:ring-2 focus:ring-primary/20 py-2.5 px-3"
                    required
                  />
                </div>
              </div>
            </div>

            <!-- Pre-Visit 60s Clinical Brief (Optional) -->
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 space-y-4">
              <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">4. Pre-Visit Clinical Brief (Optional)</h3>
                <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-[10px] font-bold text-emerald-800">Saves Consult Time</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="chiefComplaint" class="block text-xs font-semibold text-slate-700 mb-1">Main Symptoms / Reason</label>
                  <input type="text" id="chiefComplaint" name="chiefComplaint" value="<%= safeComplaint %>" placeholder="e.g. Fever & cough" class="block w-full rounded-xl border border-slate-300 bg-white text-xs text-slate-900 py-2.5 px-3" />
                </div>
                <div>
                  <label for="symptomDuration" class="block text-xs font-semibold text-slate-700 mb-1">Duration</label>
                  <input type="text" id="symptomDuration" name="symptomDuration" placeholder="e.g. 3 days / 2 weeks" class="block w-full rounded-xl border border-slate-300 bg-white text-xs text-slate-900 py-2.5 px-3" />
                </div>
                <div>
                  <label for="allergies" class="block text-xs font-semibold text-slate-700 mb-1">Known Allergies</label>
                  <input type="text" id="allergies" name="allergies" value="<%= (locals.patientdata && patientdata.allergies) || '' %>" placeholder="e.g. Penicillin, Dust (or None)" class="block w-full rounded-xl border border-slate-300 bg-white text-xs text-slate-900 py-2.5 px-3" />
                </div>
                <div>
                  <label for="currentMedications" class="block text-xs font-semibold text-slate-700 mb-1">Current Medications</label>
                  <input type="text" id="currentMedications" name="currentMedications" placeholder="e.g. Metformin 500mg daily" class="block w-full rounded-xl border border-slate-300 bg-white text-xs text-slate-900 py-2.5 px-3" />
                </div>
              </div>
            </div>

            <!-- Booking Actions -->
            <div class="pt-5 border-t border-slate-100">
              <% if (user) { %>
                <button
                  id="book-btn"
                  type="submit"
                  class="w-full rounded-2xl bg-gradient-to-r from-primary to-indigo-600 py-4 text-center text-sm font-bold text-white shadow-xl shadow-primary/25 transition-all duration-300 hover:scale-[1.01] hover:shadow-glow-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                >
                  Pay ₹<%= docInfo.fees %> &amp; Confirm Appointment &rarr;
                </button>
              <% } else { %>
                <a
                  href="/login"
                  class="block w-full rounded-2xl bg-slate-900 py-4 text-center text-sm font-bold text-white shadow-lg transition hover:bg-primary"
                >
                  Sign in to Confirm &amp; Pay &rarr;
                </a>
              <% } %>
            </div>
          </form>
        </div>
      </main>
    </div>
  <% } else { %>
    <div class="rounded-3xl border border-slate-200 bg-white p-12 text-center max-w-lg mx-auto shadow-xs">
      <h2 class="text-xl font-bold text-slate-800">Clinician Not Found</h2>
      <p class="text-xs text-slate-500 mt-2">The requested doctor is not currently listed in our directory.</p>
      <a href="/doctors" class="mt-4 inline-block rounded-2xl bg-primary px-6 py-2.5 text-xs font-bold text-white">Back to Clinicians</a>
    </div>
  <% } %>
</div>

<% if (typeof integrationMode === 'undefined' || integrationMode === 'live') { %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<% } else if (integrationMode === 'mock') { %>
<script src="/console-assets/js/mock-checkout.js"></script>
<% } %>
<script>window.RAZORPAY_KEY = '<%= razorpayKey || "" %>';</script>
<script>window.DOCTOR_ID = '<%= docInfo ? docInfo._id : "" %>';</script>
<script src="/assets/appointment-page.js"></script>

<%- include('partials/page-end') %>
