<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'AI Clinical Health Assistant - OneLife' }) %>

<div class="py-8 max-w-4xl mx-auto">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200 pb-6 mb-7 gap-4">
    <div class="flex items-center gap-3.5">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-tr from-primary via-indigo-600 to-teal-500 text-white shadow-md shadow-primary/25 text-xl">
        🤖
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">OneLife AI Health Assistant</h1>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100/90 border border-emerald-200/60 px-2.5 py-0.5 text-[10px] font-bold text-emerald-800">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Online 24/7
          </span>
        </div>
        <p class="text-xs text-slate-500 mt-0.5">Automated clinical query triage, symptom guidelines, and verified medical education.</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a href="/doctors" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-800 shadow-2xs hover:border-primary hover:text-primary transition">
        <span>🩺 Consult a Doctor</span>
      </a>
    </div>
  </div>

  <!-- Medical Safety & Emergency Notice -->
  <div class="mb-6 rounded-2xl border border-rose-200/90 bg-rose-50/90 p-4 text-xs text-rose-900 flex items-start gap-3 shadow-xs">
    <span class="text-base leading-none">⚠️</span>
    <div class="leading-relaxed">
      <strong>Important Medical Advisory:</strong> This AI assistant provides general health education and does not replace professional clinical evaluation or emergency services. In acute life-threatening situations, dial <strong>112 / 911</strong> immediately.
    </div>
  </div>

  <!-- Chat Container -->
  <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-xl flex flex-col h-[670px]">
    <!-- Chat Header Banner -->
    <div class="bg-gradient-to-r from-slate-950 via-indigo-950 to-slate-900 px-6 py-4 text-white flex items-center justify-between border-b border-indigo-900/50">
      <div class="flex items-center gap-2.5 text-xs font-semibold">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Secure Clinical Consultation Session</span>
      </div>
      <span class="text-[11px] text-slate-400 font-mono">256-Bit TLS Encrypted</span>
    </div>

    <!-- Messages Log Area -->
    <div
      id="messages"
      role="log"
      aria-live="polite"
      aria-relevant="additions"
      class="flex-1 overflow-y-auto bg-slate-50/60 p-6 space-y-4 custom-scrollbar"
    >
      <!-- Initial AI Greeting -->
      <div class="flex items-start gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-tr from-primary to-indigo-600 text-white text-xs font-bold shadow-md shadow-primary/20">
          AI
        </div>
        <div class="max-w-[85%] rounded-2xl bg-white border border-slate-200/90 p-4 text-xs sm:text-sm text-slate-800 shadow-xs leading-relaxed">
          <p class="font-semibold text-slate-900 mb-1">Hello! I am your OneLife Clinical Health Assistant.</p>
          <p>You can ask me about symptoms, preventive health measures, common medications, or guidance on which clinical specialist to consult. How can I assist your health journey today?</p>
        </div>
      </div>
    </div>

    <!-- Quick Suggestion Chips -->
    <div class="border-t border-slate-100 bg-white px-6 py-3 overflow-x-auto flex items-center gap-2 text-xs">
      <span class="font-bold text-slate-400 shrink-0 text-[11px] uppercase tracking-wider">Suggested:</span>
      <button type="button" class="quick-chip shrink-0 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-slate-700 hover:border-primary hover:bg-indigo-50 hover:text-primary transition font-medium">
        Managing chronic migraine
      </button>
      <button type="button" class="quick-chip shrink-0 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-slate-700 hover:border-primary hover:bg-indigo-50 hover:text-primary transition font-medium">
        Early signs of diabetes
      </button>
      <button type="button" class="quick-chip shrink-0 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-slate-700 hover:border-primary hover:bg-indigo-50 hover:text-primary transition font-medium">
        When to visit a cardiologist
      </button>
    </div>

    <!-- Input Form -->
    <form id="send-msg" class="border-t border-slate-200 bg-white p-4 flex items-center gap-3">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
      <label for="message-input" class="sr-only">Your medical question</label>
      <input
        type="text"
        id="message-input"
        placeholder="Type a health question or symptom here (e.g. causes of persistent fatigue)…"
        autocomplete="off"
        class="flex-1 rounded-2xl border border-slate-300 bg-slate-50/80 px-4 py-3.5 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-2xs transition"
      />
      <button
        type="submit"
        id="send-btn"
        class="inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-primary to-indigo-600 px-6 py-3.5 text-xs sm:text-sm font-bold text-white shadow-md shadow-primary/25 transition-all duration-200 hover:scale-[1.02] hover:shadow-glow-primary disabled:opacity-50"
      >
        <span id="send-label">Send</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </form>
  </div>
</div>

<script>
  const sendMessage = async (message) => {
    try {
      const response = await fetch("/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message }),
      });

      if (!response.ok) {
        throw new Error(`HTTP Error: ${response.status}`);
      }

      const data = await response.json();
      return {
        message: data.message || "I apologize, but I could not process your query at this moment.",
        emergency: Boolean(data.emergency),
        sources: Array.isArray(data.sources) ? data.sources : [],
      };
    } catch (error) {
      console.error("Error fetching AI response:", error);
      return {
        message: "I am temporarily unable to connect to the medical knowledge base. Please consult our hospital specialists or contact support.",
        emergency: false,
        sources: [],
      };
    }
  };

  const form = document.getElementById("send-msg");
  const input = document.getElementById("message-input");
  const sendButton = document.getElementById("send-btn");
  const sendLabel = document.getElementById("send-label");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const message = input.value.trim();
    if (!message) return;

    appendMessage(message, "right");
    input.value = "";
    input.disabled = true;
    sendButton.disabled = true;
    sendLabel.textContent = "Analyzing…";
    document.getElementById("messages").setAttribute("aria-busy", "true");

    try {
      const chatbotResponse = await sendMessage(message);
      appendMessage(chatbotResponse.message, "left", chatbotResponse.emergency);
      appendSources(chatbotResponse.sources);
    } finally {
      input.disabled = false;
      sendButton.disabled = false;
      sendLabel.textContent = "Send";
      document.getElementById("messages").setAttribute("aria-busy", "false");
      input.focus();
    }
  });

  const appendMessage = (message, position, emergency = false) => {
    const messages = document.getElementById("messages");
    const container = document.createElement("div");

    if (position === "right") {
      container.className = "flex justify-end";
      container.innerHTML = `
        <div class="max-w-[85%] rounded-2xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-3.5 text-xs sm:text-sm text-white shadow-md">
          ${escapeHtml(message)}
        </div>
      `;
    } else {
      container.className = "flex items-start gap-3";
      const emergencyClass = emergency
        ? "border-2 border-rose-300 bg-rose-50 text-rose-950 font-medium"
        : "border border-slate-200 bg-white text-slate-800";
      container.innerHTML = `
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl ${emergency ? 'bg-rose-600' : 'bg-gradient-to-tr from-primary to-indigo-600'} text-white text-xs font-bold shadow-md">
          ${emergency ? '🚨' : 'AI'}
        </div>
        <div class="max-w-[85%] rounded-2xl ${emergencyClass} p-4 text-xs sm:text-sm shadow-xs leading-relaxed">
          ${escapeHtml(message)}
        </div>
      `;
    }

    messages.appendChild(container);
    messages.scrollTop = messages.scrollHeight;
  };

  const appendSources = (sources) => {
    if (!sources || !sources.length) return;
    const messages = document.getElementById("messages");
    const sourceElement = document.createElement("div");
    sourceElement.className = "ml-12 flex flex-wrap items-center gap-2 text-xs text-primary font-medium";

    const label = document.createElement("span");
    label.className = "text-slate-500 font-semibold";
    label.textContent = "Clinical Resources:";
    sourceElement.appendChild(label);

    sources.forEach((source) => {
      if (!source || !source.label || !source.url) return;
      const link = document.createElement("a");
      link.href = source.url;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.className = "rounded-md bg-indigo-50 px-2 py-1 text-primary hover:bg-indigo-100 transition underline";
      link.textContent = source.label;
      sourceElement.appendChild(link);
    });

    messages.appendChild(sourceElement);
    messages.scrollTop = messages.scrollHeight;
  };

  function escapeHtml(text) {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  // Quick Chips Click Handlers
  document.querySelectorAll(".quick-chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      input.value = chip.textContent.trim();
      form.requestSubmit();
    });
  });
</script>

<%- include('partials/page-end') %>

