<%- include('head') %>
<main class="flex min-h-screen items-center justify-center bg-gray-200 p-4">
    <div id="chat-container" class="flex w-full max-h-[80vh] max-w-2xl flex-col overflow-hidden rounded-lg bg-white shadow-xl">
        <!-- Header -->
        <div class="bg-blue-600 px-6 py-4 text-center text-lg font-bold text-white">
            OneLife Health Information
        </div>
        <p class="px-5 pt-4 text-xs leading-5 text-gray-500">General information only—not diagnosis or emergency care. For urgent symptoms, contact local emergency services.</p>

        <!-- Messages Area -->
        <div id="messages" role="log" aria-live="polite" aria-relevant="additions" class="flex flex-grow flex-col space-y-4 overflow-y-auto bg-gray-50 p-4">
            <div class="flex justify-start">
                <span class="inline-block max-w-[75%] break-words rounded-lg bg-gray-300 px-4 py-2 text-gray-800 shadow-md">Hello. Ask a health or medical-information question and I’ll do my best to help.</span>
            </div>
        </div>

        <!-- Message Input -->
        <form action="#" id="send-msg" class="flex items-center w-full p-4 bg-white border-t border-gray-300"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
            <label for="message-input" class="sr-only">Your medical question</label>
            <input 
                type="text" 
                id="message-input" 
                placeholder="Ask a medical question..."
                autocomplete="off"
                class="flex-grow p-3 border border-gray-300 rounded-l-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            <button 
                type="submit" 
                id="send-btn" 
                class="p-3 ml-1 text-white transition-colors bg-blue-600 rounded-r-lg hover:bg-blue-700"
            >
                <span id="send-label">Send</span>
            </button>
        </form>
    </div>
</main>
<script>
    const sendMessage = async (message) => {
  try {
    const response = await fetch("/chat", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ message }),
    });

    if (!response.ok) {
      throw new Error(`HTTP Error: ${response.status}`);
    }

    const data = await response.json();
    return {
      message: data.message || "Oops, I couldn't process your request.",
      emergency: Boolean(data.emergency),
      sources: Array.isArray(data.sources) ? data.sources : [],
    };
  } catch (error) {
    console.error("Error fetching AI response:", error);
    return { message: "Sorry, something went wrong.", emergency: false, sources: [] };
  }
};

// Handling chat form submission
const form = document.getElementById("send-msg");
form.addEventListener("submit", async (e) => {
  e.preventDefault();
  const message = document.getElementById("message-input").value.trim();

  if (!message) return; // Skip sending if the input is empty

  const input = document.getElementById("message-input");
  const sendButton = document.getElementById("send-btn");
  const sendLabel = document.getElementById("send-label");

  appendMessage(message, 'right');
  input.value = '';
  input.disabled = true;
  sendButton.disabled = true;
  sendLabel.textContent = 'Sending…';
  document.getElementById("messages").setAttribute('aria-busy', 'true');

  try {
    const chatbotResponse = await sendMessage(message);
    appendMessage(chatbotResponse.message, 'left', chatbotResponse.emergency);
    appendSources(chatbotResponse.sources);
  } finally {
    input.disabled = false;
    sendButton.disabled = false;
    sendLabel.textContent = 'Send';
    document.getElementById("messages").setAttribute('aria-busy', 'false');
    input.focus();
  }
});

const appendMessage = (message, position, emergency = false) => {
  const messages = document.getElementById("messages");
  const messageElement = document.createElement("div");

  // Create message text element
  const textElement = document.createElement("span");
  textElement.innerText = message;

  // Apply classes based on the position (user's message or chatbot response)
  const baseClasses = 'inline-block px-4 py-2 max-w-[75%] break-words rounded-lg shadow-md';
  const leftClasses = emergency ? 'border border-red-300 bg-red-50 text-red-900' : 'bg-gray-300 text-gray-800';
  const rightClasses = 'bg-blue-500 text-white'; // User's messages
  textElement.className = `${baseClasses} ${position === 'right' ? rightClasses : leftClasses}`;

  messageElement.className = `flex ${position === 'right' ? 'justify-end' : 'justify-start'} mb-2`;
  messageElement.appendChild(textElement);

  // Append message to the chat
  messages.append(messageElement);

  // Auto-scroll to the bottom
  messages.scrollTop = messages.scrollHeight;
};

const appendSources = (sources) => {
  if (!sources.length) return;
  const messages = document.getElementById("messages");
  const sourceElement = document.createElement("div");
  const label = document.createElement("span");
  label.className = "mr-2 font-semibold text-gray-700";
  label.textContent = "Health resources:";
  sourceElement.className = "flex flex-wrap items-center gap-2 text-xs text-blue-700";
  sourceElement.appendChild(label);

  sources.forEach((source) => {
    if (!source || !source.label || !source.url) return;
    const link = document.createElement("a");
    link.href = source.url;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.className = "underline hover:text-blue-900";
    link.textContent = source.label;
    sourceElement.appendChild(link);
  });
  messages.append(sourceElement);
  messages.scrollTop = messages.scrollHeight;
};

</script>
<%- include('bottom') %>
