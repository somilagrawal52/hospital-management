<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'My Health Profile - OneLife' }) %>

<div class="py-8 max-w-2xl mx-auto">
  <div class="border-b border-slate-200 pb-5 mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary">Patient Demographics</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Personal Health Profile</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">Keep your demographic and contact details updated for hospital coordination and digital billing.</p>
    </div>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Verified Account
    </span>
  </div>

  <div id="profile-container" class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xl">
    <% if (locals.user) { %>
      <!-- Avatar Section -->
      <div class="flex flex-col sm:flex-row items-center gap-6 pb-6 border-b border-slate-100">
        <div class="relative group cursor-pointer">
          <input id="image-input" type="file" class="hidden" accept="image/jpeg,image/png,image/webp" />
          <img
            id="profile-image" 
            class="h-28 w-28 rounded-2xl object-cover border-4 border-indigo-50 shadow-md bg-slate-100" 
            src="<%= (patientdata && patientdata.image) ? patientdata.image : '/assets/onelife-avatar.svg' %>"
            alt="Profile Avatar"
          />
          <div class="absolute inset-0 rounded-2xl bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-semibold">
            Change Photo
          </div>
        </div>
        
        <div class="text-center sm:text-left flex-1">
          <input
            id="fullname-input"
            class="hidden w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-1.5 text-lg font-bold text-slate-900 focus:border-primary focus:bg-white"
            type="text"
            value="<%= (patientdata && patientdata.fullname) || '' %>"
          />
          <h2 id="fullname-text" class="text-2xl font-bold text-slate-900"><%= (patientdata && patientdata.fullname) || 'Patient' %></h2>
          <p class="text-xs font-medium text-slate-500 mt-1"><%= (patientdata && patientdata.email) || user.email %> · Role: <span class="uppercase font-semibold text-primary"><%= user.role %></span></p>
        </div>
      </div>

      <!-- Information Sections -->
      <div class="py-6 border-b border-slate-100 space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Contact Details</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-y-3 text-xs">
          <span class="font-semibold text-slate-500">Email Address:</span>
          <div>
            <input id="email-input" class="hidden w-full max-w-sm rounded-lg border border-slate-300 px-3 py-1 text-xs" type="email" value="<%= (patientdata && patientdata.email) || '' %>" />
            <p id="email-text" class="font-semibold text-primary"><%= (patientdata && patientdata.email) || 'N/A' %></p>
          </div>

          <span class="font-semibold text-slate-500">Phone Number:</span>
          <div>
            <input id="phone-input" class="hidden w-full max-w-sm rounded-lg border border-slate-300 px-3 py-1 text-xs" type="number" value="<%= (patientdata && patientdata.number) || '' %>" />
            <p id="phone-text" class="font-semibold text-slate-800"><%= (patientdata && patientdata.number) || 'Not provided' %></p>
          </div>

          <span class="font-semibold text-slate-500">Residential Address:</span>
          <div>
            <div id="address-input" class="hidden space-y-2 max-w-sm">
              <input id="address-input-1" class="w-full rounded-lg border border-slate-300 px-3 py-1 text-xs" type="text" value="<%= (patientdata && patientdata.address && patientdata.address.line1) || '' %>" placeholder="Address Line 1" />
              <input id="address-input-2" class="w-full rounded-lg border border-slate-300 px-3 py-1 text-xs" type="text" value="<%= (patientdata && patientdata.address && patientdata.address.line2) || '' %>" placeholder="Address Line 2" />
            </div>
            <p id="address-text" class="text-slate-700 leading-relaxed">
              <%= (patientdata && patientdata.address && patientdata.address.line1) || 'No street address set' %><br />
              <%= (patientdata && patientdata.address && patientdata.address.line2) || '' %>
            </p>
          </div>
        </div>
      </div>

      <!-- Basic Biological Info -->
      <div class="py-6 border-b border-slate-100 space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Demographic Information</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-y-3 text-xs">
          <span class="font-semibold text-slate-500">Gender:</span>
          <div>
            <select id="gender-input" class="hidden rounded-lg border border-slate-300 px-3 py-1 text-xs">
              <option value="Male" <%= (patientdata && patientdata.gender === "Male") ? "selected" : "" %>>Male</option>
              <option value="Female" <%= (patientdata && patientdata.gender === "Female") ? "selected" : "" %>>Female</option>
              <option value="Other" <%= (patientdata && patientdata.gender === "Other") ? "selected" : "" %>>Other</option>
            </select>
            <p id="gender-text" class="font-semibold text-slate-800"><%= (patientdata && patientdata.gender) || 'Not specified' %></p>
          </div>

          <span class="font-semibold text-slate-500">Date of Birth:</span>
          <div>
            <input id="dob-input" class="hidden rounded-lg border border-slate-300 px-3 py-1 text-xs" type="date" value="<%= (patientdata && patientdata.dob) || '' %>" />
            <p id="dob-text" class="font-semibold text-slate-800"><%= (patientdata && patientdata.dob) || 'Not specified' %></p>
          </div>
        </div>
      </div>

      <!-- Edit / Save Actions -->
      <div class="pt-6 flex items-center gap-3">
        <button id="edit-button" class="rounded-xl border border-primary bg-primary px-6 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-indigo-600 transition">
          Edit Profile
        </button>
        <button id="save-button" class="hidden rounded-xl border border-emerald-600 bg-emerald-600 px-6 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-emerald-700 transition">
          Save Changes
        </button>
      </div>
    <% } %>
  </div>
</div>

<script src="/assets/profile-page.js"></script>
<%- include('partials/page-end') %>
