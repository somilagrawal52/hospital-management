<%- include('head') %>
<div class="mx-4 sm:mx-[10%]">
<%- include('Navbar') %>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        } */

        .container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            padding: 40px;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            font-weight: 300;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .search-section {
            padding: 40px;
        }

        .search-form {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .search-input {
            flex: 1;
            padding: 15px 20px;
            border: 2px solid #e1e8ed;
            border-radius: 50px;
            font-size: 16px;
            outline: none;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            border-color: #4facfe;
            box-shadow: 0 0 0 3px rgba(79, 172, 254, 0.1);
        }

        .search-btn {
            padding: 15px 30px;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            border: none;
            border-radius: 50px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .search-btn:hover {
            transform: translateY(-2px);
        }

        .examples {
            margin-bottom: 30px;
        }

        .examples h3 {
            color: #333;
            margin-bottom: 15px;
        }

        .example-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .example-tag {
            padding: 8px 16px;
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 14px;
        }

        .example-tag:hover {
            background: #4facfe;
            color: white;
            border-color: #4facfe;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 20px;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #4facfe;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .results {
            display: none;
            margin-top: 30px;
        }

        .disease-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 25px;
            border-left: 5px solid #4facfe;
        }

        .disease-title {
            font-size: 1.8em;
            color: #333;
            margin-bottom: 20px;
            text-transform: capitalize;
        }

        .info-section {
            margin-bottom: 25px;
        }

        .info-section h4 {
            color: #4facfe;
            font-size: 1.2em;
            margin-bottom: 10px;
            border-bottom: 2px solid #e9ecef;
            padding-bottom: 5px;
        }

        .info-content {
            line-height: 1.6;
            color: #555;
        }

        .info-list {
            list-style: none;
            padding-left: 0;
        }

        .info-list li {
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .info-list li:before {
            content: "• ";
            color: #4facfe;
            font-weight: bold;
            margin-right: 8px;
        }

        .error {
            background: #ffe6e6;
            color: #d63384;
            padding: 20px;
            border-radius: 10px;
            border-left: 5px solid #d63384;
            display: none;
        }

        .source-link {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }

        .source-link a {
            color: #4facfe;
            text-decoration: none;
            font-weight: 500;
        }

        .source-link a:hover {
            text-decoration: underline;
        }

        @media (max-width: 768px) {
            .search-form {
                flex-direction: column;
            }
            
            .example-tags {
                justify-content: center;
            }
            
            .header h1 {
                font-size: 2em;
            }
        }
    </style>
    <div class="container">
        <div class="header">
            <h1>OneLife Disease Information System</h1>
            <p>Get comprehensive disease information from the World Health Organization</p>
        </div>

        <div class="search-section">
            <form class="search-form" id="searchForm">
                <input 
                    type="text" 
                    class="search-input" 
                    id="diseaseInput"
                    placeholder="Enter disease name (e.g., diabetes, malaria, covid-19)"
                    required
                >
                <button type="submit" class="search-btn">Search</button>
            </form>

            <div class="examples">
                <h3>Try these examples:</h3>
                <div class="example-tags">
                    <span class="example-tag" onclick="searchDisease('diabetes')">Diabetes</span>
                    <span class="example-tag" onclick="searchDisease('malaria')">Malaria</span>
                    <span class="example-tag" onclick="searchDisease('tuberculosis')">Tuberculosis</span>

                    <span class="example-tag" onclick="searchDisease('dengue')">Dengue</span>
                    <span class="example-tag" onclick="searchDisease('hepatitis')">Hepatitis</span>
                </div>
            </div>

            <div class="loading" id="loading">
                <div class="spinner"></div>
                <p>Fetching disease information from WHO...</p>
            </div>

            <div class="error" id="error"></div>

            <div class="results" id="results">
                <div class="disease-card">
                    <h2 class="disease-title" id="diseaseTitle"></h2>
                    
                    <div class="info-section" id="introSection">
                        <h4>Overview</h4>
                        <div class="info-content" id="introContent"></div>
                    </div>

                    <div class="info-section" id="factsSection">
                        <h4>Key Facts</h4>
                        <ul class="info-list" id="factsList"></ul>
                    </div>

                    <div class="info-section" id="symptomsSection">
                        <h4>Symptoms & Signs</h4>
                        <ul class="info-list" id="symptomsList"></ul>
                    </div>

                    <div class="info-section" id="treatmentSection">
                        <h4>Treatment</h4>
                        <ul class="info-list" id="treatmentList"></ul>
                    </div>

                    <div class="info-section" id="preventionSection">
                        <h4>Prevention</h4>
                        <ul class="info-list" id="preventionList"></ul>
                    </div>

                    <div class="source-info">
                        <small>Information scraped from WHO health topics</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById('searchForm');
        const input = document.getElementById('diseaseInput');
        const loading = document.getElementById('loading');
        const error = document.getElementById('error');
        const results = document.getElementById('results');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const diseaseName = input.value.trim();
            if (diseaseName) {
                await searchDisease(diseaseName);
            }
        });

        async function searchDisease(diseaseName) {
            // Update input if called from example tags
            input.value = diseaseName;
            
            // Show loading, hide others
            loading.style.display = 'block';
            error.style.display = 'none';
            results.style.display = 'none';

            try {
                const response = await fetch(`/disease/${encodeURIComponent(diseaseName)}`);
                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'Failed to fetch data');
                }

                displayResults(data);
            } catch (err) {
                showError(err.message);
            } finally {
                loading.style.display = 'none';
            }
        }

        function displayResults(data) {
            document.getElementById('diseaseTitle').textContent = data.pageTitle || data.disease;
            document.getElementById('introContent').textContent = data.intro;

            // Populate lists
            populateList('factsList', data.keyFacts);
            populateList('symptomsList', data.symptoms);
            populateList('treatmentList', data.treatment);
            populateList('preventionList', data.prevention);

            // Show/hide sections based on content
            toggleSection('factsSection', data.keyFacts);
            toggleSection('symptomsSection', data.symptoms);
            toggleSection('treatmentSection', data.treatment);
            toggleSection('preventionSection', data.prevention);

            results.style.display = 'block';
        }

        function populateList(listId, items) {
            const list = document.getElementById(listId);
            list.innerHTML = '';
            
            if (items && items.length > 0) {
                items.forEach(item => {
                    if (item && item !== "No symptoms section found" && item !== "No key facts found" && 
                        item !== "No treatment info found" && item !== "No prevention info found") {
                        const li = document.createElement('li');
                        li.textContent = item;
                        list.appendChild(li);
                    }
                });
            }
        }

        function toggleSection(sectionId, data) {
            const section = document.getElementById(sectionId);
            const hasValidData = data && data.length > 0 && 
                !data.every(item => item.includes("not found") || item.includes("No "));
            
            section.style.display = hasValidData ? 'block' : 'none';
        }

        function showError(message) {
            error.textContent = message;
            error.style.display = 'block';
        }

        // Add enter key support for example tags
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && document.activeElement.classList.contains('example-tag')) {
                document.activeElement.click();
            }
        });
    </script>
<%- include('footer') %>
</div>
<%- include('bottom') %>