<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'About Us - OneLife Hospital Platform' }) %>

<div class="py-8 max-w-5xl mx-auto">
  <!-- Header -->
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="inline-block rounded-full bg-primary/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-primary">About OneLife</span>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2">Pioneering Digital Hospital Care</h1>
    <p class="text-xs sm:text-sm text-slate-600 mt-2">Connecting patients, clinicians, and hospital administrators on an unified, dependable healthcare platform.</p>
  </div>

  <!-- Story & Vision Section -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mb-16">
    <div class="lg:col-span-5">
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-900 shadow-xl">
        <img class="h-80 w-full object-cover object-top" src="/assets/onelife-team-generated.png" alt="OneLife Medical Care Team" />
      </div>
    </div>
    <div class="lg:col-span-7 space-y-4 text-xs sm:text-sm text-slate-600 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Our Clinical Mission</h2>
      <p>
        OneLife was engineered to overcome the bottlenecks of traditional outpatient hospital visits. By integrating certified specialist directory discovery, real-time doctor availability calendars, automated waitlists, and encrypted Jitsi WebRTC video consultations into a single platform, we reduce waiting time from hours to minutes.
      </p>
      <p>
        Whether a patient visits our central hospital campus in person or connects via secure video from home, our platform guarantees that medical records, doctor assignments, and digital GST payment receipts remain coherent and immediately accessible.
      </p>
      <div class="pt-2 grid grid-cols-2 gap-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <strong class="text-primary text-xl font-extrabold block">10,000+</strong>
          <span class="text-xs text-slate-500">Patients Coordinated</span>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <strong class="text-emerald-600 text-xl font-extrabold block">99.8%</strong>
          <span class="text-xs text-slate-500">Service Availability</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Why Choose Us Pillars -->
  <div class="mb-16">
    <div class="text-center max-w-xl mx-auto mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Why Patients &amp; Clinicians Choose OneLife</h2>
      <p class="text-xs text-slate-500 mt-1">Core architectural pillars that define our patient-centric medical experience.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm space-y-3">
        <div class="h-10 w-10 rounded-xl bg-indigo-50 text-primary flex items-center justify-center text-xl font-bold">⚡</div>
        <h3 class="text-sm font-bold text-slate-900">Zero-Wait Scheduling</h3>
        <p class="text-xs text-slate-600 leading-relaxed">Direct synchronization with doctor slot calendars eliminates crowded waiting rooms and lets patients select exact consultation times.</p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm space-y-3">
        <div class="h-10 w-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl font-bold">🛡️</div>
        <h3 class="text-sm font-bold text-slate-900">High-Security Telehealth</h3>
        <p class="text-xs text-slate-600 leading-relaxed">Browser-native WebRTC encryption ensures patient privacy during virtual consultations, meeting strict healthcare data standards.</p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm space-y-3">
        <div class="h-10 w-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">🤖</div>
        <h3 class="text-sm font-bold text-slate-900">Intelligent Health Guidance</h3>
        <p class="text-xs text-slate-600 leading-relaxed">Integrated clinical AI assistant and WHO disease knowledge base provide 24/7 educational guidance and emergency triage escalation.</p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/page-end') %>
