<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'My Appointments - OneLife' }) %>
    <div class="py-10">
        <div class="flex flex-col gap-3 border-b pb-5 sm:flex-row sm:items-end sm:justify-between">
          <div><p class="text-2xl font-semibold text-gray-800">My appointments</p><p class="mt-1 text-sm text-gray-500">Track your bookings, payment status, and online consultation requests.</p></div>
          <div class="rounded-lg bg-primary/10 px-4 py-2 text-sm text-primary"><span class="font-semibold"><%= patientdata?.upcomingAppointmentsCount || 0 %></span> upcoming</div>
        </div>
        <div class="mt-4 space-y-4">
          <% if (patientdata && patientdata.appointments && patientdata.appointments.length > 0) { %>
            <% patientdata.appointments.forEach((item, index) => { %>
              <% const status = item.status || 'pending'; %>
              <div class="flex flex-col gap-5 rounded-xl border border-gray-200 bg-white p-5 shadow-sm sm:flex-row sm:items-start">
                <div>
                  <img class="h-28 w-28 rounded-lg bg-[#EAEFFF] object-cover" src="<%= item.doctordata?.image || '/assets/doc1.png' %>" alt="Dr. <%= item.doctordata?.fullname || 'Doctor' %>">
                </div>
                <div class="flex-1 text-sm text-[#5E5E5E]">
                  <p class="text-[#262626] text-base font-semibold">Dr. <%= item.doctordata.fullname %></p>
                  <p><%= item.doctordata.speciality %></p>
                  <p class="text-[#464646] font-medium mt-1">Address:</p>
                  <p><%= item.address.line1 %></p>
                  <p><%= item.address.line2 %></p>
                  <p class="mt-1"><span class="text-sm text-[#faadad] font-medium">Date & Time: </span><%= item.formattedDate %></p>
                  <p class="mt-2"><span class="rounded-full px-2.5 py-1 text-xs font-medium <%= status === 'cancelled' ? 'bg-red-100 text-red-700' : status === 'completed' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700' %>"><%= status.replace(/_/g, ' ') %></span></p>
                </div>
                <div class="flex flex-col justify-end gap-2 text-sm text-center sm:ml-auto sm:min-w-48">
                  <% if (status !== 'cancelled' && status !== 'completed') { %>
                  <button class="appointment-action text-[#696969] sm:min-w-48 py-2 border rounded hover:bg-primary hover:text-white transition-all duration-300" data-action="cancel" data-appointment-id="<%= item._id %>">Cancel Appointment</button>
                  <button class="appointment-action text-[#696969] sm:min-w-48 py-2 border rounded hover:bg-primary hover:text-white transition-all duration-300" data-action="reschedule" data-appointment-id="<%= item._id %>">Reschedule</button>
                  <% } %>
                  <% if (!item.isOnline && status !== 'cancelled' && status !== 'completed') { %>
                  <button class="appointment-action text-[#696969] sm:min-w-48 py-2 border rounded hover:bg-primary hover:text-white transition-all duration-300" data-action="online" data-appointment-id="<%= item._id %>">Book An Online Video Conference Instead</button>
                  <% } %>
                  <% if (item.video?.status === 'scheduled' || item.video?.status === 'in_progress') { %>
                    <a class="sm:min-w-48 py-2 border rounded text-primary border-primary hover:bg-primary hover:text-white transition-all duration-300" href="/appointments/<%= item._id %>/video/join">Join video consultation</a>
                    <a class="sm:min-w-48 py-2 border rounded text-[#696969] hover:bg-gray-100 transition-all duration-300" href="/appointments/<%= item._id %>/video/calendar">Add to calendar</a>
                  <% } else if (item.video?.status === 'requested') { %>
                    <p class="text-xs text-gray-500">Online consultation request pending doctor approval.</p>
                  <% } %>
                </div>
              </div>
              <% if (status !== 'cancelled' && status !== 'completed') { %>
                <div id="reschedule-<%= item._id %>" class="reschedule-panel hidden rounded-xl border border-primary/20 bg-primary/5 p-4" data-appointment-id="<%= item._id %>" data-doctor-id="<%= String(item.doctorId || item.docId) %>">
                  <p class="text-sm font-semibold text-gray-800">Choose a new available slot</p>
                  <form class="reschedule-form mt-3 grid gap-3 sm:grid-cols-3 sm:items-end">
                    <label class="text-xs text-gray-600">New date<input type="date" required class="reschedule-date mt-1 block w-full rounded border-gray-300 text-sm"></label>
                    <label class="text-xs text-gray-600">Available time<select required disabled class="reschedule-time mt-1 block w-full rounded border-gray-300 text-sm"><option value="">Choose a date first</option></select></label>
                    <button type="submit" class="rounded bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-dark">Save new time</button>
                  </form>
                  <p class="reschedule-message mt-2 text-xs text-gray-500">Select a date to load real-time available slots.</p>
                </div>
              <% } %>
              
            <% }) %>
          <% } else { %>
            <div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-8 text-center text-sm text-gray-500">No appointments yet. Browse doctors to book your first consultation.</div>
          <% } %>
        </div>
        <% if (patientdata?.waitlist?.length) { %>
          <section class="mt-8 rounded-xl border border-amber-200 bg-amber-50 p-5">
            <h2 class="text-base font-semibold text-amber-950">Your waitlist requests</h2>
            <div class="mt-3 space-y-3">
              <% patientdata.waitlist.forEach((entry) => { %>
                <div class="flex flex-col gap-3 rounded-lg border border-amber-200 bg-white p-4 sm:flex-row sm:items-center sm:justify-between">
                  <div class="text-sm text-gray-700"><span class="font-semibold">Dr. <%= entry.doctorId?.fullname || 'Doctor' %></span><span class="mx-1">·</span><%= entry.slotDate %><span class="mx-1">·</span><span class="capitalize"><%= entry.status %></span></div>
                  <button class="waitlist-cancel rounded border border-amber-400 px-3 py-1.5 text-xs font-medium text-amber-900 hover:bg-amber-100" data-waitlist-id="<%= entry._id %>">Leave waitlist</button>
                </div>
              <% }) %>
            </div>
          </section>
        <% } %>
      </div>
<script src="/assets/my-appointments-page.js"></script>
<%- include('partials/page-end') %>
