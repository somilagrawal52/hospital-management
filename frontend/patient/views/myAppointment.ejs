<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'My Appointments - OneLife' }) %>

<div class="py-8">
  <!-- Heading & Overview -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-slate-200 pb-7 mb-10 gap-4">
    <div>
      <span class="inline-block rounded-full bg-indigo-50 border border-indigo-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-primary">Patient Care Portal</span>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2.5 tracking-tight">My Appointments &amp; Consultations</h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-1.5">Manage scheduled clinic visits, join virtual telehealth sessions, reschedule slots, and download invoices.</p>
    </div>
    
    <!-- Quick Stat Chips -->
    <div class="flex items-center gap-3">
      <div class="rounded-2xl border border-indigo-100 bg-indigo-50/80 px-4 py-2.5 text-xs font-semibold text-primary shadow-xs">
        <span class="font-extrabold text-sm"><%= patientdata?.upcomingAppointmentsCount || 0 %></span> Upcoming
      </div>
      <% if (patientdata?.waitlist?.length) { %>
        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-2.5 text-xs font-semibold text-amber-900 shadow-xs">
          <span class="font-extrabold text-sm"><%= patientdata.waitlist.length %></span> On Waitlist
        </div>
      <% } %>
    </div>
  </div>

  <!-- Appointments List -->
  <div class="space-y-6">
    <% if (patientdata && patientdata.appointments && patientdata.appointments.length > 0) { %>
      <% patientdata.appointments.forEach((item, index) => { %>
        <% 
          const status = item.status || 'pending';
          const isCancelled = status === 'cancelled';
          const isCompleted = status === 'completed';
          const isOnline = Boolean(item.isOnline);
        %>
        <article class="overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-xs transition-all duration-300 hover:shadow-xl hover:border-primary/40">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-slate-100 bg-slate-50/70 px-6 py-4 gap-2">
            <div class="flex items-center gap-2.5">
              <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Booking ID:</span>
              <span class="font-mono text-xs font-bold text-slate-800 bg-white px-2 py-0.5 rounded-md border border-slate-200 shadow-2xs"><%= String(item._id).slice(-8).toUpperCase() %></span>
              <% if (isOnline) { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-100/80 border border-indigo-200/60 px-2.5 py-0.5 text-[10px] font-extrabold text-primary">
                  <span>📹</span> Telehealth
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-0.5 text-[10px] font-bold text-slate-700">
                  <span>🏥</span> In-Clinic Visit
                </span>
              <% } %>
            </div>

            <!-- Status Pill Badge -->
            <div>
              <% if (status === 'confirmed') { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100/90 border border-emerald-200 px-3 py-1 text-xs font-bold text-emerald-800 ring-1 ring-emerald-500/20">
                  <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span> Confirmed
                </span>
              <% } else if (status === 'completed') { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 border border-slate-200 px-3 py-1 text-xs font-bold text-slate-700">
                  <span class="h-2 w-2 rounded-full bg-slate-500"></span> Completed
                </span>
              <% } else if (status === 'cancelled') { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-100 border border-rose-200 px-3 py-1 text-xs font-bold text-rose-800">
                  <span class="h-2 w-2 rounded-full bg-rose-500"></span> Cancelled
                </span>
              <% } else if (status === 'online_requested') { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 border border-amber-200 px-3 py-1 text-xs font-bold text-amber-800">
                  <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span> Video Request Pending
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 border border-blue-200 px-3 py-1 text-xs font-bold text-blue-800">
                  <span class="h-2 w-2 rounded-full bg-blue-500"></span> <%= status.replace(/_/g, ' ') %>
                </span>
              <% } %>
            </div>
          </div>

          <!-- Card Body -->
          <div class="p-6 sm:p-7">
            <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
              <!-- Doctor & Appointment Info -->
              <div class="flex items-start gap-5">
                <img
                  class="h-20 w-20 sm:h-24 sm:w-24 rounded-2xl object-cover border-2 border-indigo-50 shadow-md bg-slate-100 shrink-0"
                  src="<%= item.doctordata?.image || '/assets/onelife-clinician-generated.png' %>"
                  alt="Dr. <%= item.doctordata?.fullname || item.doctor || 'Clinician' %>"
                />
                <div class="space-y-1.5">
                  <div class="flex items-center gap-2">
                    <h3 class="text-base sm:text-lg font-bold text-slate-900">Dr. <%= item.doctordata?.fullname || item.doctor %></h3>
                    <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] text-white font-bold" title="Verified Clinician">✓</span>
                  </div>
                  <p class="text-xs font-bold text-primary"><%= item.doctordata?.speciality || 'Specialist' %></p>
                  
                  <div class="pt-2 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-slate-600">
                    <div class="flex items-center gap-1.5 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-200/60 font-semibold">
                      <span class="text-primary font-bold">📅</span>
                      <strong class="text-slate-900"><%= item.formattedDate %></strong>
                    </div>
                    <div class="flex items-center gap-1.5 text-slate-600">
                      <span>📍</span>
                      <span><%= (item.address && item.address.line1) || 'OneLife Medical Complex' %>, <%= (item.address && item.address.line2) || '' %></span>
                    </div>
                    <div class="flex items-center gap-1.5 text-slate-600">
                      <span>💳</span>
                      <span>Paid ₹<%= item.amount || (item.payment && item.payment.amount) || '—' %></span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Buttons Row -->
              <div class="flex flex-wrap lg:flex-col items-stretch gap-2.5 w-full lg:w-60 shrink-0">
                <!-- Video Call Join -->
                <% if (item.video?.status === 'scheduled' || item.video?.status === 'in_progress') { %>
                  <a
                    href="/appointments/<%= item._id %>/video/join"
                    class="inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 px-4 py-3 text-xs font-extrabold text-white shadow-lg shadow-emerald-600/25 hover:from-emerald-700 hover:to-teal-700 hover:scale-[1.02] transition"
                  >
                    <span class="flex h-2 w-2 rounded-full bg-white animate-ping"></span>
                    <span>📹 Join Video Call</span>
                  </a>
                  <a
                    href="/appointments/<%= item._id %>/video/calendar"
                    class="inline-flex items-center justify-center gap-1.5 rounded-2xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition"
                  >
                    <span>📅 Add to Calendar (.ics)</span>
                  </a>
                <% } else if (item.video?.status === 'requested') { %>
                  <p class="rounded-2xl border border-amber-200 bg-amber-50 p-2.5 text-center text-[11px] font-semibold text-amber-900">
                    Online consultation request awaiting doctor confirmation
                  </p>
                <% } %>

                <!-- Download Invoice PDF -->
                <% if (item.invoiceFile || status === 'confirmed' || status === 'completed') { %>
                  <% const invoiceFileName = item.invoiceFile || `invoice-${item._id}.pdf`; %>
                  <a
                    href="/download-pdf?file=<%= encodeURIComponent(invoiceFileName) %>"
                    class="inline-flex items-center justify-center gap-1.5 rounded-2xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-bold text-slate-800 hover:border-primary hover:text-primary hover:bg-slate-50 transition shadow-2xs"
                  >
                    <span>📄 Download Invoice (PDF)</span>
                  </a>
                <% } %>

                <!-- Interactive Booking Controls -->
                <% if (!isCancelled && !isCompleted) { %>
                  <% if (!item.isOnline) { %>
                    <button
                      type="button"
                      class="appointment-action inline-flex items-center justify-center gap-1.5 rounded-2xl border border-indigo-200 bg-indigo-50/70 px-3.5 py-2 text-xs font-bold text-primary hover:bg-primary hover:text-white transition"
                      data-action="online"
                      data-appointment-id="<%= item._id %>"
                    >
                      <span>📹 Switch to Video Visit</span>
                    </button>
                  <% } %>

                  <button
                    type="button"
                    class="appointment-action inline-flex items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition"
                    data-action="reschedule"
                    data-appointment-id="<%= item._id %>"
                  >
                    <span>🕒 Reschedule Slot</span>
                  </button>

                  <button
                    type="button"
                    class="appointment-action inline-flex items-center justify-center gap-1.5 rounded-2xl border border-rose-200 bg-white px-3.5 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 transition"
                    data-action="cancel"
                    data-appointment-id="<%= item._id %>"
                  >
                    <span>✕ Cancel Booking</span>
                  </button>
                <% } %>
              </div>
            </div>

            <!-- Reschedule Accordion Panel -->
            <% if (!isCancelled && !isCompleted) { %>
              <div
                id="reschedule-<%= item._id %>"
                class="reschedule-panel hidden mt-6 rounded-3xl border border-primary/20 bg-indigo-50/40 p-6 transition-all"
                data-appointment-id="<%= item._id %>"
                data-doctor-id="<%= String(item.doctorId || item.docId) %>"
              >
                <div class="flex items-center gap-2 mb-3.5">
                  <span class="text-primary font-bold text-base">🕒</span>
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">Choose a New Available Consultation Slot</h4>
                </div>
                <form class="reschedule-form grid gap-4 sm:grid-cols-3 sm:items-end">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                  <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">New Calendar Date</label>
                    <input type="date" required class="reschedule-date block w-full rounded-2xl border-slate-300 bg-white text-xs font-semibold text-slate-900 shadow-xs focus:border-primary focus:ring-primary py-2.5 px-3" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Available Slot Time</label>
                    <select required disabled class="reschedule-time block w-full rounded-2xl border-slate-300 bg-white text-xs font-semibold text-slate-900 shadow-xs focus:border-primary focus:ring-primary py-2.5 px-3">
                      <option value="">Choose a date first</option>
                    </select>
                  </div>
                  <button type="submit" class="rounded-2xl bg-primary px-4 py-2.5 text-xs font-bold text-white shadow-md hover:bg-indigo-600 transition">
                    Save New Appointment Time
                  </button>
                </form>
                <p class="reschedule-message mt-2.5 text-xs text-slate-500 font-medium">Select a date above to query the clinician’s real-time schedule.</p>
              </div>
            <% } %>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <!-- Clean Empty State -->
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-14 text-center shadow-xs">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-2xl text-primary mb-4 shadow-xs">
          📅
        </div>
        <h3 class="text-lg font-bold text-slate-900">No Appointments Booked Yet</h3>
        <p class="text-xs text-slate-500 mt-1.5 max-w-sm mx-auto">You do not have any scheduled appointments. Browse our certified doctors to book your first clinic or video consultation.</p>
        <a href="/doctors" class="mt-5 inline-block rounded-2xl bg-primary px-6 py-3 text-xs font-bold text-white shadow-md shadow-primary/25 hover:bg-indigo-600 transition">
          Find a Doctor &rarr;
        </a>
      </div>
    <% } %>
  </div>

  <!-- Waitlist Requests Section -->
  <% if (patientdata?.waitlist?.length) { %>
    <section class="mt-12 rounded-3xl border border-amber-200 bg-amber-50/60 p-6 sm:p-8 shadow-xs">
      <div class="flex items-center gap-2.5 mb-4">
        <span class="text-amber-700 font-bold text-xl">⏰</span>
        <div>
          <h2 class="text-base font-bold text-amber-950">Active Waitlist Requests</h2>
          <p class="text-xs text-amber-800">You will receive an automated email notification as soon as a slot opens for these dates.</p>
        </div>
      </div>
      <div class="space-y-3">
        <% patientdata.waitlist.forEach((entry) => { %>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between rounded-2xl border border-amber-200/80 bg-white p-4 shadow-xs gap-3">
            <div class="text-xs text-slate-700">
              <span class="font-bold text-slate-900 text-sm">Dr. <%= entry.doctorId?.fullname || 'Clinician' %></span>
              <span class="mx-2 text-slate-300">|</span>
              <span class="text-primary font-bold"><%= entry.doctorId?.speciality || 'Department' %></span>
              <span class="mx-2 text-slate-300">|</span>
              <span>Requested Date: <strong><%= entry.slotDate %></strong></span>
              <span class="mx-2 text-slate-300">|</span>
              <span class="capitalize font-semibold text-amber-700"><%= entry.status %></span>
            </div>
            <button
              type="button"
              class="waitlist-cancel rounded-xl border border-amber-300 bg-amber-50 px-3.5 py-1.5 text-xs font-bold text-amber-900 hover:bg-amber-100 transition shadow-2xs"
              data-waitlist-id="<%= entry._id %>"
            >
              Leave Waitlist
            </button>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>

<script src="/assets/my-appointments-page.js"></script>
<%- include('partials/page-end') %>

