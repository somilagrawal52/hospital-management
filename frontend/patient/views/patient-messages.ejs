<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'Messages - OneLife' }) %>

  <div class="max-w-3xl mx-auto py-12">
    <div class="text-center">
      <p class="text-2xl text-[#707070]">SEND A <span class="font-semibold text-gray-700">MESSAGE</span></p>
      <p class="mt-3 text-sm text-gray-500">Share your question and the hospital team can review it from the admin panel.</p>
    </div>

    <% if (success) { %>
      <div class="mt-8 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
        Your message was sent successfully.
      </div>
    <% } %>

    <form action="/messages" method="post" class="mt-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm space-y-5"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
        <input
          type="text"
          name="fullname"
          value="<%= patientdata?.fullname || '' %>"
          class="w-full rounded-lg border-gray-300 focus:border-primary focus:ring-primary"
          required
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Question</label>
        <input
          type="text"
          name="question"
          class="w-full rounded-lg border-gray-300 focus:border-primary focus:ring-primary"
          placeholder="Write a short subject"
          required
        />
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="category" class="mb-2 block text-sm font-medium text-gray-700">Category</label>
          <select id="category" name="category" class="w-full rounded-lg border-gray-300 focus:border-primary focus:ring-primary">
            <option value="appointment">Appointment</option>
            <option value="billing">Billing</option>
            <option value="account">Account</option>
            <option value="technical">Technical issue</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label for="priority" class="mb-2 block text-sm font-medium text-gray-700">Priority</label>
          <select id="priority" name="priority" class="w-full rounded-lg border-gray-300 focus:border-primary focus:ring-primary">
            <option value="normal">Normal</option>
            <option value="high">High</option>
            <option value="urgent">Urgent</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Message</label>
        <textarea
          name="msgbody"
          rows="6"
          class="w-full rounded-lg border-gray-300 focus:border-primary focus:ring-primary"
          placeholder="Describe your question or issue"
          required
        ></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white rounded-lg bg-primary hover:bg-gray-700 transition"
      >
        Send Message
      </button>
    </form>

    <section class="mt-12 space-y-5" aria-label="Your support requests">
      <div>
        <h2 class="text-xl font-semibold text-gray-800">Your support requests</h2>
        <p class="mt-1 text-sm text-gray-500">Reply to an open request or check its current status.</p>
      </div>
      <% if (threads && threads.length) { %>
        <% threads.forEach((thread) => { %>
          <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="font-semibold text-gray-900"><%= thread.subject %></h3>
                <p class="mt-1 text-xs uppercase tracking-wide text-gray-500"><%= thread.category %> · <%= new Date(thread.lastMessageAt).toLocaleString('en-IN') %></p>
              </div>
              <span class="w-fit rounded-full px-3 py-1 text-xs font-medium <%= thread.status === 'resolved' ? 'bg-green-100 text-green-700' : thread.priority === 'urgent' ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700' %>"><%= thread.status.replace('_', ' ') %></span>
            </div>
            <div class="mt-4 space-y-3">
              <% thread.messages.forEach((message) => { %>
                <div class="rounded-lg p-3 text-sm <%= message.senderRole === 'ADMIN' ? 'bg-primary/10 text-gray-800' : 'bg-gray-50 text-gray-700' %>">
                  <p class="mb-1 text-xs font-semibold text-gray-500"><%= message.senderRole === 'ADMIN' ? 'OneLife support' : 'You' %></p>
                  <p><%= message.body %></p>
                </div>
              <% }) %>
            </div>
            <% if (thread.status !== 'resolved') { %>
              <form class="mt-4 flex gap-2" method="post" action="/support/threads/<%= thread._id %>/replies"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                <label class="sr-only" for="reply-<%= thread._id %>">Reply to <%= thread.subject %></label>
                <input id="reply-<%= thread._id %>" name="message" required maxlength="3000" class="min-w-0 flex-1 rounded-lg border-gray-300 text-sm focus:border-primary focus:ring-primary" placeholder="Add a reply" />
                <button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700" type="submit">Reply</button>
              </form>
            <% } %>
          </article>
        <% }) %>
      <% } else { %>
        <p class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-500">No support requests yet.</p>
      <% } %>
    </section>
  </div>
<%- include('partials/page-end') %>
