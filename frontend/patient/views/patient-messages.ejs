<%- include('partials/page-start', { includeHeroHeader: false, pageTitle: 'Support Inbox - OneLife' }) %>

<div class="py-8 max-w-3xl mx-auto">
  <div class="border-b border-slate-200 pb-5 mb-8">
    <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary">Patient Assistance</span>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Hospital Support &amp; Inquiries</h1>
    <p class="text-xs sm:text-sm text-slate-500 mt-1">Submit inquiries regarding appointments, invoicing, medical records, or platform technical support.</p>
  </div>

  <% if (success) { %>
    <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-3.5 text-xs font-semibold text-emerald-800 shadow-sm flex items-center gap-2">
      <span class="text-emerald-600 font-bold">✓</span> Your support request was submitted successfully. Our hospital administration team will review and reply shortly.
    </div>
  <% } %>

  <!-- New Ticket Form -->
  <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm mb-12">
    <div class="border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-lg font-bold text-slate-900">Open a New Support Ticket</h2>
      <p class="text-xs text-slate-500 mt-0.5">Please provide clear details so the appropriate hospital department can assist you.</p>
    </div>

    <form action="/messages" method="post" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Your Full Name</label>
        <input
          type="text"
          name="fullname"
          value="<%= (locals.patientdata && patientdata.fullname) ? patientdata.fullname : '' %>"
          placeholder="e.g. John Doe"
          class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-xs text-slate-900 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          required
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Subject / Question</label>
        <input
          type="text"
          name="question"
          class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-xs text-slate-900 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          placeholder="Brief summary of your inquiry"
          required
        />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="category" class="block text-xs font-semibold text-slate-700 mb-1">Inquiry Category</label>
          <select id="category" name="category" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-xs text-slate-900 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20">
            <option value="appointment">Appointment &amp; Scheduling</option>
            <option value="billing">Billing &amp; Invoices</option>
            <option value="account">Account &amp; Profile</option>
            <option value="technical">Technical Support</option>
            <option value="other">General Inquiries</option>
          </select>
        </div>
        <div>
          <label for="priority" class="block text-xs font-semibold text-slate-700 mb-1">Urgency Level</label>
          <select id="priority" name="priority" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-xs text-slate-900 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20">
            <option value="normal">Normal (Response within 24 hours)</option>
            <option value="high">High (Priority review)</option>
            <option value="urgent">Urgent</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Detailed Message</label>
        <textarea
          name="msgbody"
          rows="4"
          class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-xs text-slate-900 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          placeholder="Describe your issue or question in detail…"
          required
        ></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-2.5 text-xs font-bold text-white shadow-md shadow-primary/20 hover:bg-indigo-600 transition"
      >
        <span>Submit Support Ticket</span> &rarr;
      </button>
    </form>
  </div>

  <!-- Prior Support Threads List -->
  <section class="space-y-4" aria-label="Your support requests">
    <div class="border-b border-slate-200 pb-3">
      <h2 class="text-lg font-bold text-slate-900">Your Support Conversation Threads</h2>
      <p class="text-xs text-slate-500 mt-0.5">Track administration replies and maintain ongoing dialogue.</p>
    </div>

    <% if (threads && threads.length) { %>
      <% threads.forEach((thread) => { %>
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 border-b border-slate-100 pb-3">
            <div>
              <h3 class="font-bold text-slate-900 text-sm"><%= thread.subject %></h3>
              <p class="text-[11px] text-slate-500 mt-0.5 capitalize">Category: <span class="font-semibold text-slate-700"><%= thread.category %></span> · Last Activity: <%= new Date(thread.lastMessageAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
            </div>
            <span class="rounded-full px-3 py-1 text-xs font-bold capitalize <%= thread.status === 'resolved' ? 'bg-emerald-100 text-emerald-800' : thread.priority === 'urgent' ? 'bg-rose-100 text-rose-800' : 'bg-indigo-100 text-primary' %>">
              <%= thread.status.replace('_', ' ') %>
            </span>
          </div>

          <!-- Messages in Thread -->
          <div class="space-y-3">
            <% thread.messages.forEach((message) => { %>
              <div class="rounded-xl p-3.5 text-xs leading-relaxed <%= message.senderRole === 'ADMIN' ? 'bg-indigo-50/70 border border-indigo-100 text-slate-800' : 'bg-slate-50 text-slate-700' %>">
                <div class="flex items-center justify-between mb-1 text-[11px]">
                  <strong class="<%= message.senderRole === 'ADMIN' ? 'text-primary' : 'text-slate-800' %>"><%= message.senderRole === 'ADMIN' ? 'OneLife Hospital Administration' : 'You' %></strong>
                </div>
                <p><%= message.body %></p>
              </div>
            <% }) %>
          </div>

          <!-- Quick Reply Form if not resolved -->
          <% if (thread.status !== 'resolved') { %>
            <form class="flex gap-2 pt-2 border-t border-slate-100" method="post" action="/support/threads/<%= thread._id %>/replies">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
              <label class="sr-only" for="reply-<%= thread._id %>">Reply to <%= thread.subject %></label>
              <input id="reply-<%= thread._id %>" name="message" required maxlength="3000" class="min-w-0 flex-1 rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2 text-xs text-slate-900 focus:border-primary focus:bg-white focus:outline-none" placeholder="Type a follow-up reply…" />
              <button class="rounded-xl bg-primary px-4 py-2 text-xs font-bold text-white hover:bg-indigo-600 transition shrink-0" type="submit">
                Reply
              </button>
            </form>
          <% } %>
        </article>
      <% }) %>
    <% } else { %>
      <div class="rounded-2xl border border-dashed border-slate-300 p-8 text-center text-xs text-slate-500">
        You have no active support requests. Use the form above to reach the administration team.
      </div>
    <% } %>
  </section>
</div>

<%- include('partials/page-end') %>
