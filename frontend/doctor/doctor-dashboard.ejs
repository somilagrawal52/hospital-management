<%- include('partials/head', { pageTitle: 'Doctor dashboard | OneLife' }) %>
<%- include('partials/header', { doctor, brandLabel: 'Clinician workspace', showMessagesLink: true }) %>

<main id="main-content" class="console-main">
  <header class="console-page-heading"><div><p class="console-eyebrow">Clinician workspace</p><h1>Welcome, Dr. <%= doctor?.fullname || '' %></h1><p>Review upcoming appointments and manage care requests.</p></div><a class="console-button" href="/doctor/availability">Manage availability</a></header>
  <section class="console-grid console-grid--metrics" aria-label="Doctor activity"><article class="console-metric"><div class="console-metric__label"><span class="nav-glyph" aria-hidden="true">P</span>Assigned patients</div><p class="console-metric__value"><%= patientsAssignedCount %></p><p class="console-metric__note">Patients in your appointment history</p></article><article class="console-metric"><div class="console-metric__label"><span class="nav-glyph" aria-hidden="true">C</span>Fellow doctors</div><p class="console-metric__value"><%= fellowDoctorsCount %></p><p class="console-metric__note">Clinicians on the platform</p></article><article class="console-metric"><div class="console-metric__label"><span class="nav-glyph" aria-hidden="true">A</span>Booking status</div><p class="console-metric__value"><%= doctor?.available ? 'Open' : 'Paused' %></p><p class="console-metric__note"><a href="/doctor/availability"><%= doctor?.available ? 'Patients can book appointments' : 'New bookings are paused' %></a></p></article></section>
  <section class="console-panel" style="margin-top: 1.2rem"><div class="console-panel__header"><div><h2>Patient appointments</h2><p><%= upcomingAppointmentsCount %> upcoming appointment<%= upcomingAppointmentsCount === 1 ? '' : 's' %>.</p></div><a class="console-button console-button--quiet console-button--small" href="/showdocmsg">Online requests (<%= onlineRequestsCount %>)</a></div><div class="console-panel__body"><div class="console-table-tools"><label>Search appointments<input type="search" data-table-search="#doctor-appointments" placeholder="Search patient, date, or status" /></label><div class="console-pagination" data-table-pagination="#doctor-appointments" aria-label="Appointment pages"></div></div><div class="console-table-wrap"><table id="doctor-appointments" class="console-table" data-enhanced-table data-page-size="6"><thead><tr><th><button type="button" data-sort-column="0">Patient</button></th><th><button type="button" data-sort-column="1">Email</button></th><th>Phone</th><th><button type="button" data-sort-column="3">Date</button></th><th><button type="button" data-sort-column="4">Status</button></th><th>Update</th></tr></thead><tbody><% appointments.forEach((appointment) => { %><% const status = appointment.status || 'pending'; const statusTone = status === 'cancelled' ? 'danger' : status === 'completed' ? 'success' : status === 'pending' || status === 'online_requested' ? 'warning' : ''; %><tr><td><%= appointment.fullname || '—' %></td><td><%= appointment.email || '—' %></td><td><%= appointment.number || '—' %></td><td><%= appointment.formattedDate %></td><td><span class="console-pill <%= statusTone ? `console-pill--${statusTone}` : '' %>"><%= status.replace(/_/g, ' ') %></span></td><td><% if (!['completed', 'cancelled'].includes(status)) { %><div class="console-inline"><select class="status-select" aria-label="Update appointment status"><option value="">Update status</option><% if (status !== 'confirmed') { %><option value="confirmed">Confirm</option><% } %><option value="completed">Complete</option><option value="cancelled">Cancel</option></select><button type="button" class="console-button console-button--small update-status" data-id="<%= appointment._id %>">Save</button></div><% } else { %><span class="console-status">Final</span><% } %></td></tr><% }) %></tbody></table></div><% if (!appointments.length) { %><p class="console-empty">No appointments have been assigned yet.</p><% } %></div></section>
</main>
<%- include('partials/footer') %>
<script>document.addEventListener('click', async (event) => { const button = event.target.closest('.update-status'); if (!button) return; const status = button.closest('td').querySelector('.status-select').value; if (!status) return window.alert('Choose a new status first.'); button.disabled = true; try { const response = await fetch('/appointments/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ appointmentId: button.dataset.id, status }) }); const data = await response.json(); if (!response.ok || !data.success) throw new Error(data.message || 'Unable to update appointment.'); window.location.reload(); } catch (error) { button.disabled = false; window.alert(error.message || 'Unable to update appointment.'); } });</script>
<%- include('partials/scripts') %>
