<header class="console-header">
  <a class="console-brand" href="/doctor" aria-label="OneLife doctor dashboard">
    <span class="console-brand__mark" aria-hidden="true"></span>
    <span class="console-brand__copy"><strong>OneLife</strong><span><%= brandLabel || 'Clinician workspace' %></span></span>
  </a>
  <nav class="console-inline" aria-label="Doctor navigation">
    <a class="console-button console-button--quiet console-button--small" href="/doctor">Dashboard</a>
    <a class="console-button console-button--quiet console-button--small" href="/doctor/availability">Availability</a>
    <% if (showMessagesLink) { %><a class="console-button console-button--quiet console-button--small" href="/showdocmsg">Requests</a><% } %>
    <details class="console-menu"><summary aria-label="Open doctor account menu"><span class="console-avatar"><%= (doctor?.fullname || 'D').charAt(0).toUpperCase() %></span><span><%= doctor?.fullname || 'Doctor' %></span></summary><div class="console-menu__panel"><a href="/doctorlogout">Sign out</a></div></details>
  </nav>
</header>
