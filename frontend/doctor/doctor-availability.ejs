<%- include('partials/head', { pageTitle: 'Availability calendar | OneLife' }) %>
<%- include('partials/header', { doctor, brandLabel: 'Clinician workspace', showMessagesLink: true }) %>

<main id="main-content" class="console-main">
  <header class="console-page-heading"><div><p class="console-eyebrow">Dr. <%= doctor.fullname %></p><h1>Availability calendar</h1><p>Set recurring clinic hours and date-specific exceptions. Patients only see open slots.</p></div><div class="console-inline"><label class="console-inline"><input id="clinic-open" type="checkbox" <%= doctor.available ? 'checked' : '' %> /> Accept new bookings</label><span id="save-status" class="console-status" role="status"></span></div></header>
  <section class="console-grid console-grid--wide"><div class="console-stack"><article class="console-panel"><div class="console-panel__header"><div><h2>Weekly working hours</h2><p>All times are in Asia/Kolkata.</p></div></div><div class="console-panel__body"><div class="console-table-wrap"><table class="console-table availability-table" aria-label="Weekly working hours"><thead><tr><th>Day</th><th>Available</th><th>From</th><th>Until</th><th>Slot length</th></tr></thead><tbody id="weekly-rules"></tbody></table></div><div class="console-form-actions" style="margin-top: 1rem"><button id="save-availability" type="button" class="console-button">Save calendar</button></div></div></article><article class="console-panel"><div class="console-panel__header"><div><h2>Date exceptions</h2><p>Close the clinic for a date or use different hours.</p></div><button id="add-exception" type="button" class="console-button console-button--quiet console-button--small">Add date</button></div><div id="exceptions" class="console-panel__body console-stack"></div></article></div><aside class="console-panel"><div class="console-panel__header"><div><h2>Calendar preview</h2><p>Check the slots shown to patients.</p></div></div><div class="console-panel__body console-form"><div class="console-field"><label for="preview-date">Choose a date</label><input id="preview-date" type="date" /></div><div id="preview-result" class="console-status">Choose a date to view available slots.</div></div></aside></section>
</main>
<%- include('partials/footer') %>
<script>
  const doctorId = <%- JSON.stringify(String(doctor._id)) %>;
  let availability = <%- JSON.stringify(availability).replace(/</g, '\\u003c') %>;
  const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const weeklyRoot = document.getElementById('weekly-rules'); const exceptionsRoot = document.getElementById('exceptions'); const previewDate = document.getElementById('preview-date'); const previewResult = document.getElementById('preview-result'); const saveStatus = document.getElementById('save-status'); const clinicOpen = document.getElementById('clinic-open');
  const today = () => { const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date()).reduce((result, item) => ({ ...result, [item.type]: item.value }), {}); return `${parts.year}-${parts.month}-${parts.day}`; };
  const timeInput = (value, className) => { const input = document.createElement('input'); input.type = 'time'; input.value = value || '09:00'; input.className = className; return input; };
  function renderWeekly() { weeklyRoot.replaceChildren(); dayNames.forEach((name, day) => { const rule = availability.weekly.find((item) => Number(item.day) === day) || { day, enabled: day !== 0, startTime: '09:00', endTime: '17:00', slotMinutes: 30 }; const row = document.createElement('tr'); row.dataset.day = day; const dayCell = document.createElement('th'); dayCell.scope = 'row'; dayCell.textContent = name; const enabledCell = document.createElement('td'); const enabled = document.createElement('input'); enabled.type = 'checkbox'; enabled.checked = Boolean(rule.enabled); enabled.className = 'availability-enabled'; enabled.setAttribute('aria-label', `${name} available`); enabledCell.append(enabled); const startCell = document.createElement('td'); startCell.append(timeInput(rule.startTime, 'availability-start')); const endCell = document.createElement('td'); endCell.append(timeInput(rule.endTime, 'availability-end')); const lengthCell = document.createElement('td'); const length = document.createElement('select'); length.className = 'availability-duration'; [15, 20, 30, 45, 60].forEach((minutes) => length.add(new Option(`${minutes} min`, minutes, false, Number(rule.slotMinutes) === minutes))); lengthCell.append(length); row.append(dayCell, enabledCell, startCell, endCell, lengthCell); weeklyRoot.append(row); }); }
  function exceptionRow(exception = {}) { const row = document.createElement('div'); row.className = 'availability-exception'; const date = document.createElement('input'); date.type = 'date'; date.min = today(); date.value = exception.date || ''; date.className = 'exception-date'; const unavailable = document.createElement('input'); unavailable.type = 'checkbox'; unavailable.checked = Boolean(exception.unavailable); unavailable.className = 'exception-unavailable'; const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'console-button console-button--danger console-button--small'; remove.textContent = 'Remove'; remove.addEventListener('click', () => row.remove()); const start = timeInput(exception.startTime, 'exception-start'); const end = timeInput(exception.endTime || '17:00', 'exception-end'); const duration = document.createElement('select'); duration.className = 'exception-duration'; [15, 20, 30, 45, 60].forEach((minutes) => duration.add(new Option(`${minutes} min`, minutes, false, Number(exception.slotMinutes || 30) === minutes))); row.innerHTML = '<div class="console-form-grid console-form-grid--three"><label class="console-field">Date</label><label class="console-field">Availability</label><span class="console-field"></span><label class="console-field exception-hours">From</label><label class="console-field exception-hours">Until</label><label class="console-field exception-hours">Slot length</label></div>'; const fields = row.querySelectorAll('.console-field'); fields[0].append(date); fields[1].append(unavailable, document.createTextNode(' Unavailable all day')); fields[2].append(remove); fields[3].append(start); fields[4].append(end); fields[5].append(duration); const sync = () => row.querySelectorAll('.exception-hours').forEach((item) => { item.hidden = unavailable.checked; }); unavailable.addEventListener('change', sync); sync(); return row; }
  function renderExceptions() { exceptionsRoot.replaceChildren(); availability.exceptions.forEach((exception) => exceptionsRoot.append(exceptionRow(exception))); }
  function collectAvailability() { return { weekly: [...weeklyRoot.querySelectorAll('tr')].map((row) => ({ day: Number(row.dataset.day), enabled: row.querySelector('.availability-enabled').checked, startTime: row.querySelector('.availability-start').value, endTime: row.querySelector('.availability-end').value, slotMinutes: Number(row.querySelector('.availability-duration').value) })), exceptions: [...exceptionsRoot.children].map((row) => ({ date: row.querySelector('.exception-date').value, unavailable: row.querySelector('.exception-unavailable').checked, startTime: row.querySelector('.exception-start').value, endTime: row.querySelector('.exception-end').value, slotMinutes: Number(row.querySelector('.exception-duration').value) })).filter((item) => item.date) }; }
  async function showPreview() { if (!previewDate.value) return; previewResult.textContent = 'Loading slots…'; try { const response = await fetch(`/doctors/${doctorId}/slots?date=${encodeURIComponent(previewDate.value)}`); const data = await response.json(); if (!response.ok) throw new Error(data.message || 'Unable to load slots.'); if (!data.slots.length) { previewResult.textContent = data.unavailable ? 'Your calendar is marked unavailable.' : 'No bookable slots for this date.'; return; } previewResult.textContent = `${data.slots.length} slots visible to patients: ${data.slots.map((slot) => new Date(slot.startsAt).toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' })).join(', ')}`; } catch (error) { previewResult.textContent = error.message; } }
  document.getElementById('add-exception').addEventListener('click', () => exceptionsRoot.append(exceptionRow()));
  clinicOpen.addEventListener('change', async () => { clinicOpen.disabled = true; saveStatus.textContent = 'Updating booking status…'; try { const response = await fetch('/change-availability', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ doctorId }) }); const data = await response.json(); if (!response.ok || !data.success) throw new Error(data.message || 'Unable to update booking status.'); saveStatus.textContent = clinicOpen.checked ? 'New bookings enabled.' : 'New bookings paused.'; } catch (error) { clinicOpen.checked = !clinicOpen.checked; saveStatus.textContent = error.message; } finally { clinicOpen.disabled = false; } });
  document.getElementById('save-availability').addEventListener('click', async (event) => { event.currentTarget.disabled = true; saveStatus.textContent = 'Saving…'; try { const response = await fetch('/doctor/availability', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(collectAvailability()) }); const data = await response.json(); if (!response.ok || !data.success) throw new Error(data.message || 'Unable to save calendar.'); availability = data.availability; renderWeekly(); renderExceptions(); saveStatus.textContent = 'Saved.'; showPreview(); } catch (error) { saveStatus.textContent = error.message; } finally { event.currentTarget.disabled = false; } });
  previewDate.min = today(); previewDate.addEventListener('change', showPreview); renderWeekly(); renderExceptions();
</script>
<%- include('partials/scripts') %>
