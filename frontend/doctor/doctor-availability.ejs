<%- include('../Admin/partials/head', { pageTitle: 'Availability Calendar - OneLife' }) %>

<header class="header fixed-top d-flex align-items-center px-4">
  <a href="/doctor" class="logo d-flex align-items-center text-decoration-none">
    <img src="/admin-assets/img/logo.png" alt="OneLife" />
    <span class="d-none d-sm-block">Doctor calendar</span>
  </a>
  <nav class="ms-auto d-flex gap-3 align-items-center">
    <a href="/showdocmsg" class="btn btn-outline-primary btn-sm"><i class="bi bi-camera-video me-1"></i> Online requests</a>
    <a href="/doctor" class="btn btn-primary btn-sm">Dashboard</a>
  </nav>
</header>

<main class="container" style="padding-top: 100px; padding-bottom: 48px; max-width: 1120px;">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
      <p class="text-uppercase text-primary fw-semibold small mb-1">Dr. <%= doctor.fullname %></p>
      <h1 class="h2 mb-1">Availability calendar</h1>
      <p class="text-muted mb-0">Set recurring clinic hours and date-specific exceptions. Patients only see open slots.</p>
    </div>
    <div id="save-status" role="status" class="small text-muted"></div>
  </div>

  <div class="row g-4">
    <section class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Weekly working hours</h2>
            <span class="badge text-bg-light">All times Asia/Kolkata</span>
          </div>
          <div class="table-responsive">
            <table class="table align-middle" aria-label="Weekly working hours">
              <thead><tr><th>Day</th><th>Available</th><th>From</th><th>Until</th><th>Slot length</th></tr></thead>
              <tbody id="weekly-rules"></tbody>
            </table>
          </div>
          <button id="save-availability" type="button" class="btn btn-primary"><i class="bi bi-save me-1"></i> Save calendar</button>
        </div>
      </div>

      <div class="card shadow-sm mt-4">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <div><h2 class="h5 mb-1">Date exceptions</h2><p class="small text-muted mb-0">Close the clinic for a date or use different hours.</p></div>
            <button id="add-exception" type="button" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add date</button>
          </div>
          <div id="exceptions" class="vstack gap-2"></div>
        </div>
      </div>
    </section>

    <aside class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body p-4">
          <h2 class="h5">Calendar preview</h2>
          <p class="small text-muted">Check exactly what a patient can book before saving or after making a change.</p>
          <label for="preview-date" class="form-label">Choose a date</label>
          <input id="preview-date" type="date" class="form-control" />
          <div id="preview-result" class="mt-3 small text-muted">Choose a date to view available slots.</div>
        </div>
      </div>
    </aside>
  </div>
</main>

<script>
  const doctorId = <%- JSON.stringify(String(doctor._id)) %>;
  let availability = <%- JSON.stringify(availability).replace(/</g, '\\u003c') %>;
  const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const weeklyRoot = document.getElementById('weekly-rules');
  const exceptionsRoot = document.getElementById('exceptions');
  const previewDate = document.getElementById('preview-date');
  const previewResult = document.getElementById('preview-result');
  const saveStatus = document.getElementById('save-status');

  const localDate = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit' })
    .formatToParts(new Date()).reduce((parts, item) => ({ ...parts, [item.type]: item.value }), {});
  const today = () => { const value = localDate(); return `${value.year}-${value.month}-${value.day}`; };

  function timeInput(value, className) {
    const input = document.createElement('input');
    input.type = 'time'; input.value = value || '09:00'; input.className = `form-control form-control-sm ${className}`;
    return input;
  }

  function renderWeekly() {
    weeklyRoot.replaceChildren();
    dayNames.forEach((name, day) => {
      const rule = availability.weekly.find((item) => Number(item.day) === day) || { day, enabled: day !== 0, startTime: '09:00', endTime: '17:00', slotMinutes: 30 };
      const row = document.createElement('tr'); row.dataset.day = day;
      const dayCell = document.createElement('th'); dayCell.scope = 'row'; dayCell.textContent = name;
      const enabledCell = document.createElement('td'); const enabled = document.createElement('input'); enabled.type = 'checkbox'; enabled.checked = Boolean(rule.enabled); enabled.className = 'form-check-input availability-enabled'; enabled.setAttribute('aria-label', `${name} available`); enabledCell.append(enabled);
      const startCell = document.createElement('td'); startCell.append(timeInput(rule.startTime, 'availability-start'));
      const endCell = document.createElement('td'); endCell.append(timeInput(rule.endTime, 'availability-end'));
      const lengthCell = document.createElement('td'); const length = document.createElement('select'); length.className = 'form-select form-select-sm availability-duration'; [15, 20, 30, 45, 60].forEach((minutes) => { const option = new Option(`${minutes} min`, minutes, false, Number(rule.slotMinutes) === minutes); length.add(option); }); lengthCell.append(length);
      row.append(dayCell, enabledCell, startCell, endCell, lengthCell); weeklyRoot.append(row);
    });
  }

  function exceptionRow(exception = {}) {
    const row = document.createElement('div'); row.className = 'border rounded p-3';
    const top = document.createElement('div'); top.className = 'row g-2 align-items-end';
    const date = document.createElement('input'); date.type = 'date'; date.min = today(); date.value = exception.date || ''; date.className = 'form-control exception-date';
    const unavailable = document.createElement('input'); unavailable.type = 'checkbox'; unavailable.checked = Boolean(exception.unavailable); unavailable.className = 'form-check-input exception-unavailable';
    const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'btn btn-outline-danger btn-sm'; remove.innerHTML = '<i class="bi bi-trash"></i><span class="visually-hidden">Remove exception</span>'; remove.addEventListener('click', () => row.remove());
    const dateCol = document.createElement('div'); dateCol.className = 'col-sm-4'; dateCol.innerHTML = '<label class="form-label small">Date</label>'; dateCol.append(date);
    const closedCol = document.createElement('div'); closedCol.className = 'col-sm-4'; closedCol.innerHTML = '<label class="form-check-label small ms-2">Unavailable all day</label>'; const closedWrap = document.createElement('div'); closedWrap.className = 'form-check mt-2'; closedWrap.prepend(unavailable); closedCol.prepend(closedWrap);
    const actionCol = document.createElement('div'); actionCol.className = 'col-sm-4 text-sm-end'; actionCol.append(remove);
    top.append(dateCol, closedCol, actionCol);
    const hours = document.createElement('div'); hours.className = 'row g-2 mt-1 exception-hours';
    const start = timeInput(exception.startTime, 'exception-start'); const end = timeInput(exception.endTime || '17:00', 'exception-end'); const duration = document.createElement('select'); duration.className = 'form-select form-select-sm exception-duration'; [15, 20, 30, 45, 60].forEach((minutes) => duration.add(new Option(`${minutes} min`, minutes, false, Number(exception.slotMinutes || 30) === minutes)));
    [['From', start], ['Until', end], ['Slot length', duration]].forEach(([label, field]) => { const col = document.createElement('div'); col.className = 'col-sm-4'; const tag = document.createElement('label'); tag.className = 'form-label small'; tag.textContent = label; col.append(tag, field); hours.append(col); });
    const sync = () => { hours.classList.toggle('d-none', unavailable.checked); }; unavailable.addEventListener('change', sync); sync();
    row.append(top, hours); return row;
  }

  function renderExceptions() { exceptionsRoot.replaceChildren(); availability.exceptions.forEach((exception) => exceptionsRoot.append(exceptionRow(exception))); }
  function collectAvailability() {
    const weekly = [...weeklyRoot.querySelectorAll('tr')].map((row) => ({ day: Number(row.dataset.day), enabled: row.querySelector('.availability-enabled').checked, startTime: row.querySelector('.availability-start').value, endTime: row.querySelector('.availability-end').value, slotMinutes: Number(row.querySelector('.availability-duration').value) }));
    const exceptions = [...exceptionsRoot.children].map((row) => ({ date: row.querySelector('.exception-date').value, unavailable: row.querySelector('.exception-unavailable').checked, startTime: row.querySelector('.exception-start').value, endTime: row.querySelector('.exception-end').value, slotMinutes: Number(row.querySelector('.exception-duration').value) })).filter((item) => item.date);
    return { weekly, exceptions };
  }

  async function showPreview() {
    if (!previewDate.value) return;
    previewResult.textContent = 'Loading slots…';
    try {
      const response = await fetch(`/doctors/${doctorId}/slots?date=${encodeURIComponent(previewDate.value)}`); const data = await response.json();
      if (!response.ok) throw new Error(data.message || 'Unable to load slots.');
      previewResult.replaceChildren();
      if (!data.slots.length) { previewResult.textContent = data.unavailable ? 'Your calendar is marked unavailable.' : 'No bookable slots for this date.'; return; }
      const intro = document.createElement('p'); intro.className = 'mb-2 text-success fw-semibold'; intro.textContent = `${data.slots.length} slots visible to patients`;
      const list = document.createElement('div'); list.className = 'd-flex flex-wrap gap-2'; data.slots.forEach((slot) => { const badge = document.createElement('span'); badge.className = 'badge text-bg-light border'; badge.textContent = new Date(slot.startsAt).toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' }); list.append(badge); }); previewResult.append(intro, list);
    } catch (error) { previewResult.textContent = error.message; }
  }

  document.getElementById('add-exception').addEventListener('click', () => exceptionsRoot.append(exceptionRow()));
  document.getElementById('save-availability').addEventListener('click', async (event) => {
    event.currentTarget.disabled = true; saveStatus.textContent = 'Saving…';
    try {
      const response = await fetch('/doctor/availability', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(collectAvailability()) });
      const data = await response.json(); if (!response.ok || !data.success) throw new Error(data.message || 'Unable to save calendar.');
      availability = data.availability; renderWeekly(); renderExceptions(); saveStatus.textContent = 'Saved.'; showPreview();
    } catch (error) { saveStatus.textContent = error.message; } finally { event.currentTarget.disabled = false; }
  });
  previewDate.min = today(); previewDate.addEventListener('change', showPreview); renderWeekly(); renderExceptions();
</script>
<%- include('../Admin/partials/scripts') %>
